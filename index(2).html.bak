<!-- 1 Top announcement bar -->
<div class="announce" id="announce">
  <div class="wrap">
    <p id="annText">Free delivery on orders above Rs. 2,500 across Pakistan</p>
    <div class="links"><a href="#offers">Offers</a><a href="#affiliate">Earn with us</a><a href="#footer">Help</a></div>
    <button type="button" id="annClose" aria-label="Close announcement">&times;</button>
  </div>
</div>

<!-- 2-5 Header: logo, search, login/sign up, cart -->
<header class="top">
  <div class="wrap head">
    <a class="logo" href="#top" id="top"><i>C</i>Chowk</a>
    <button class="locbtn" type="button" id="locBtn" aria-haspopup="dialog" aria-label="Set delivery location" title="Set your delivery location" data-loc-open>
      <span class="lb-ico"><svg class="ico" aria-hidden="true"><use href="#i-pin"/></svg></span>
      <span class="lb-t"><small id="locSmall">Deliver to</small><b id="locText">Set location</b></span>
      <svg class="ico lb-chev" aria-hidden="true"><use href="#i-lchev"/></svg>
    </button>
    <form class="search" role="search" id="searchForm">
      <input id="q" type="search" placeholder="Search phones, shoes, kurtas, lamps..." aria-label="Search products">
      <button type="submit"><svg class="ico"><use href="#i-search"/></svg><span class="hide-s">Search</span></button>
    </form>
    <div class="actions">
      <a class="btn" href="#orders"><span class="hide-s">Track&nbsp;</span>orders</a>
      <button class="btn hide-s" type="button" data-auth="login">Login</button>
      <button class="btn solid" type="button" data-auth="signup">Sign up</button>
      <a class="btn hide-s" id="acctBtn" href="#account" hidden></a>
      <button class="btn hide-s" type="button" id="logoutBtn" hidden>Logout</button>
      <button class="cart" type="button" id="cartBtn" aria-label="Shopping cart"><svg class="ico"><use href="#i-cart"/></svg><span>Cart</span><b id="cartCount">0</b></button>
    </div>
  </div>
</header>

<!-- 6 Main navigation -->
<nav class="main" aria-label="Main">
  <div class="wrap">
    <button class="catbtn" type="button" id="catOpen"><svg class="ico"><use href="#i-menu"/></svg>Categories</button>
    <a href="#top">Home</a><button type="button" data-view-cart>My Cart</button><a href="#account">My Account</a><a href="#flash">Flash Sale</a><a href="#mall">Mall</a><a href="#categories">Categories</a><a href="#trending">Trending</a><a href="#best">Best Sellers</a><a href="#offers">Offers</a><a href="#global">Global</a><a href="#affiliate">Affiliate</a>
  </div>
</nav>

<main id="home">
  <!-- 7 Categories sidebar + 8 Banner slider -->
  <div class="wrap hero">
    <aside class="sidebar" aria-label="Categories sidebar">
      <h2>Shop by category</h2>
      <div id="sideCats"></div>
    </aside>
    <div class="slider" id="slider" aria-roledescription="carousel" aria-label="Featured offers">
      <div class="track" id="track">
        <div class="slide s1"><div class="txt"><small>Electronics Fest</small><h2>Phones, audio and laptops up to 60% off</h2><a class="cta" href="#flash">Shop the deals</a></div><svg class="art ico"><use href="#i-phone"/></svg></div>
        <div class="slide s2"><div class="txt"><small>Winter Edit</small><h2>Hoodies, shawls and jackets from Rs. 999</h2><a class="cta" href="#trending">See what's trending</a></div><svg class="art ico"><use href="#i-shirt"/></svg></div>
        <div class="slide s3"><div class="txt"><small>Chowk Mall</small><h2>Official brand stores with 7-day easy returns</h2><a class="cta" href="#mall">Visit the mall</a></div><svg class="art ico"><use href="#i-bag"/></svg></div>
      </div>
      <button class="arrow l" type="button" id="prev" aria-label="Previous slide">&#8249;</button>
      <button class="arrow r" type="button" id="next" aria-label="Next slide">&#8250;</button>
      <div class="dots" id="dots"></div>
    </div>
  </div>

  <!-- 9 Flash Sale -->
  <section class="blk" id="flash"><div class="wrap"><div class="sec">
    <div class="sh">
      <div class="flash-head"><h2>Flash Sale</h2>
        <div class="timer" aria-live="off"><small>Ends in</small><span id="th">00</span><em>:</em><span id="tm">00</span><em>:</em><span id="ts">00</span></div>
      </div>
      <button class="more" type="button" data-filter-jump>Shop all</button>
    </div>
    <div class="shelf" id="flashShelf"></div>
  </div></div></section>

  <!-- 10 Mall / Official Brands -->
  <section class="blk" id="mall"><div class="wrap"><div class="sec">
    <div class="sh"><h2>Chowk Mall</h2><span class="sub">Authorised sellers only. Genuine products and brand warranty.</span></div>
    <div class="brands" id="brands"></div>
  </div></div></section>

  <!-- 11 Categories section -->
  <section class="blk" id="categories"><div class="wrap"><div class="sec">
    <div class="sh"><h2>Categories</h2></div>
    <div class="cats" id="catGrid"></div>
  </div></div></section>

  <!-- 12 Just For You -->
  <section class="blk" id="foryou"><div class="wrap"><div class="sec">
    <div class="sh"><h2>Just for you</h2><span class="sub">Picked from what shoppers near you are buying this week.</span></div>
    <div class="grid" id="foryouGrid"></div>
    <div class="loadrow"><button class="btn" type="button" id="loadMore">Load more</button></div>
  </div></div></section>

  <!-- 13 Trending -->
  <section class="blk" id="trending"><div class="wrap"><div class="sec">
    <div class="sh"><h2>Trending now</h2><span class="sub">Searches and orders rising fastest in the last 7 days.</span></div>
    <div class="shelf" id="trendShelf"></div>
  </div></div></section>

  <!-- 14 Best-Selling -->
  <section class="blk" id="best"><div class="wrap"><div class="sec">
    <div class="sh"><h2>Best sellers</h2><span class="sub">Ranked by units sold this month.</span></div>
    <ol class="rank" id="rankList" style="list-style:none;margin:0;padding:0"></ol>
  </div></div></section>

  <!-- 15 Product cards / grid -->
  <section class="blk" id="products"><div class="wrap"><div class="sec">
    <div class="sh"><h2>All products</h2></div>
    <div class="chips" id="chips" role="group" aria-label="Filter products"></div>
    <div class="grid" id="prodGrid"></div>
  </div></div></section>

  <!-- 16 Discounts & Offers -->
  <section class="blk" id="offers"><div class="wrap"><div class="sec">
    <div class="sh"><h2>Discounts and offers</h2><span class="sub">Copy a code and paste it at checkout.</span></div>
    <div class="offers" id="offerList"></div>
  </div></div></section>

  <!-- 17 Global Collection -->
  <section class="blk" id="global"><div class="wrap"><div class="sec">
    <div class="sh"><h2>Global collection</h2><span class="sub">Shipped from abroad. Duties are included in the price you see.</span></div>
    <div class="glob" id="globList"></div>
  </div></div></section>

  <!-- 18 Top Categories & Brands -->
  <section class="blk" id="top-cb"><div class="wrap"><div class="sec">
    <div class="two">
      <div><div class="sh"><h2>Top categories</h2></div><ul class="tl" id="topCats"></ul></div>
      <div><div class="sh"><h2>Top brands</h2></div><div class="bchips" id="topBrands"></div></div>
    </div>
  </div></div></section>

  <!-- 22 Affiliate Program -->
  <section class="blk" id="affiliate"><div class="wrap">
    <div class="aff">
      <div>
        <h2>Share products you like. Earn when friends buy.</h2>
        <p>Get your own tracking link, post it anywhere, and collect commission on every delivered order. Payouts go to your bank, JazzCash or Easypaisa account.</p>
        <button class="btn" type="button" data-auth="signup">Join the affiliate program</button>
      </div>
      <ul>
        <li><b>8%</b>top commission</li>
        <li><b>30 days</b>cookie window</li>
        <li><b>Rs. 1,000</b>minimum payout</li>
      </ul>
    </div>
  </div></section>

  <!-- 23 Payment Methods + 25 Social Media -->
  <section class="blk"><div class="wrap"><div class="sec"><div class="pay-social">
    <div>
      <h3>Payment methods</h3>
      <div class="pay"><span>Cash on delivery</span><span>Visa</span><span>Mastercard</span><span>JazzCash</span><span>Easypaisa</span><span>Raast</span><span>Bank transfer</span></div>
    </div>
    <div>
      <h3>Follow us</h3>
      <div class="social">
        <a href="https://www.facebook.com" target="_blank" rel="noopener"><svg class="ico"><use href="#i-fb"/></svg>Facebook</a>
        <a href="https://www.instagram.com" target="_blank" rel="noopener"><svg class="ico"><use href="#i-ig"/></svg>Instagram</a>
        <a href="https://www.youtube.com" target="_blank" rel="noopener"><svg class="ico"><use href="#i-yt"/></svg>YouTube</a>
        <a href="https://www.tiktok.com" target="_blank" rel="noopener"><svg class="ico"><use href="#i-tt"/></svg>TikTok</a>
        <a href="https://x.com" target="_blank" rel="noopener"><svg class="ico"><use href="#i-x"/></svg>X</a>
      </div>
    </div>
  </div></div></div></section>
</main>

<!-- My Cart page (rendered by script) -->
<main id="cartView" hidden aria-label="My Cart"></main>

<!-- Product details page (rendered by script, route: #product-<slug>) -->
<main id="productView" hidden aria-label="Product details"></main>
<main id="ordersView" hidden aria-label="My orders"></main>
<main id="adminView" hidden aria-label="Seller dashboard (demo)"></main>
<main id="categoryView" hidden aria-label="Category"></main>
<main id="accountView" hidden aria-label="My Account"></main>
<main id="authPageView" hidden aria-label="Password help"></main>

<!-- 26 Footer / copyright -->
<footer id="footer">
  <div class="wrap">
    <div class="fcols">
      <div class="about"><a class="logo" href="#top"><i>C</i>Chowk</a><p>An online bazaar for everyday shopping, with cash on delivery and easy returns.</p></div>
      <div><h4>Customer care</h4><ul><li><a href="#footer">Help center</a></li><li><a href="#footer">How to buy</a></li><li><a href="#orders">Track your order</a></li><li><a href="#seller">Seller dashboard (demo)</a></li><li><a href="#footer">Returns and refunds</a></li></ul></div>
      <div><h4>Chowk</h4><ul><li><a href="#footer">About us</a></li><li><a href="#footer">Careers</a></li><li><a href="#footer">Terms and conditions</a></li><li><a href="#footer">Privacy policy</a></li></ul></div>
      <div><h4>Earn with us</h4><ul><li><a href="#footer">Sell on Chowk</a></li><li><a href="#affiliate">Affiliate program</a></li><li><a href="#mall">Open a brand store</a></li></ul></div>
    </div>
    <div class="copy"><span>&copy; 2026 Chowk Marketplace. All rights reserved.</span><span>Prices in Pakistani rupees (Rs.)</span></div>
  </div>
</footer>

<div class="scrim" id="drawerScrim" hidden>
  <div class="drawer" role="dialog" aria-label="Categories"><div class="dh"><h2>Categories</h2><button class="xbtn" type="button" id="catClose" aria-label="Close">&times;</button></div><div id="drawerCats"></div></div>
  <div style="flex:1" id="drawerFill"></div>
</div>
<div class="scrim center" id="authScrim" hidden>
  <div class="modal" role="dialog" aria-label="Account">
    <div class="tabs" role="tablist"><button type="button" role="tab" id="tabLogin" aria-selected="true" data-tab="login">Login</button><button type="button" role="tab" id="tabSignup" aria-selected="false" data-tab="signup">Sign up</button></div>
    <form id="authForm">
      <label id="nameWrap" hidden>Full name<input id="fname" type="text" autocomplete="name" placeholder="Ayesha Khan"></label>
      <label>Email or mobile<input id="femail" type="text" autocomplete="username" placeholder="03xx xxxxxxx"></label>
      <label>Password<input id="fpass" type="password" autocomplete="current-password" placeholder="At least 8 characters"></label>
      <a class="fgt" href="#forgot-password" id="forgotLink" hidden>Forgot password?</a>
      <p class="note" id="refNote" hidden></p>
      <p class="ferr" id="authErr" role="alert"></p>
      <button class="btn solid" type="submit" id="authSubmit">Login</button>
    </form>
    <button class="btn" type="button" id="authClose">Close</button>
  </div>
</div>
<div class="scrim loc" id="locScrim" hidden>
  <div class="locmodal" role="dialog" aria-modal="true" aria-labelledby="locTitle" tabindex="-1">
    <div class="lm-head">
      <div><h2 id="locTitle">Set delivery location</h2><p>We use it to show delivery availability, charges and arrival dates.</p></div>
      <button class="xbtn" type="button" id="locClose" aria-label="Close">&times;</button>
    </div>
    <div class="lm-body">
      <button class="lm-gps" type="button" id="locGps"><span class="g-i"><svg class="ico" aria-hidden="true"><use href="#i-gps"/></svg></span><span class="g-t"><b id="locGpsT">Use my current location</b><small>Your browser will ask for permission first</small></span></button>
      <p class="lm-msg" id="locMsg" role="status" aria-live="polite" hidden></p>
      <div class="lm-or" aria-hidden="true"><span>or</span></div>
      <div class="lm-tabs" role="tablist" aria-label="Choose how to set your location">
        <button type="button" role="tab" id="locTabSearch" aria-selected="true" aria-controls="locPanelSearch">Search location</button>
        <button type="button" role="tab" id="locTabManual" aria-selected="false" aria-controls="locForm">Enter manually</button>
      </div>
      <div id="locPanelSearch" role="tabpanel" aria-labelledby="locTabSearch">
        <label class="lm-l" for="locQ">Search your area, street or city</label>
        <div class="lm-sbox"><svg class="ico" aria-hidden="true"><use href="#i-search"/></svg><input id="locQ" type="search" autocomplete="off" autocapitalize="off" spellcheck="false" role="combobox" aria-expanded="false" aria-controls="locList" aria-autocomplete="list" placeholder="e.g. DHA Phase 5, Lahore"></div>
        <ul class="lm-list" id="locList" role="listbox" aria-label="Location suggestions" hidden></ul>
        <p class="lm-hint" id="locSMsg" role="status" aria-live="polite">Type at least 2 letters to search.</p>
      </div>
      <form id="locForm" role="tabpanel" aria-labelledby="locTabManual" novalidate hidden>
        <label class="lm-l">Country<select id="locCountry"></select></label>
        <div class="lm-two">
          <label class="lm-l">City<input id="locCity" list="locCityList" autocomplete="address-level2" placeholder="e.g. Karachi" aria-describedby="locCityE"><small class="ferr" id="locCityE"></small></label>
          <label class="lm-l">Area / neighbourhood<input id="locArea" list="locAreaList" autocomplete="address-level3" placeholder="e.g. Gulshan-e-Iqbal"></label>
        </div>
        <p class="lm-hint" id="locState" hidden></p>
        <label class="lm-l">Complete delivery address<textarea id="locAddr" rows="3" maxlength="200" autocomplete="street-address" placeholder="House / flat no., street, block, landmark" aria-describedby="locAddrE"></textarea><small class="ferr" id="locAddrE"></small></label>
        <datalist id="locCityList"></datalist><datalist id="locAreaList"></datalist>
        <button type="submit" hidden tabindex="-1" aria-hidden="true">Save</button>
      </form>
      <div class="lm-info" id="locInfo" role="status" aria-live="polite" hidden></div>
      <p class="lm-note" id="locAcct" hidden>You’re not logged in, so this location is remembered on this device only. <button class="lk" type="button" id="locLogin">Log in</button> to save it to your account.</p>
    </div>
    <div class="lm-foot">
      <button class="btn solid" type="button" id="locSave">Save location</button>
      <button class="btn" type="button" id="locCancel">Cancel</button>
      <button class="lk lm-clear" type="button" id="locClear" hidden>Remove saved location</button>
    </div>
  </div>
</div>
<div class="scrim center" id="oConfirm" hidden></div>
<div class="toast" id="toast" role="status" hidden></div>

<script>
/* Set to your backend origin (e.g. 'https://api.yourshop.pk') to use the real email-based reset. Empty = browser-only demo mode. */
window.CHOWK_API_BASE='';
</script>
<script>
(function(){
  var $=function(s,r){return (r||document).querySelector(s)};
  var fmt=function(n){return n.toLocaleString('en-PK')};
  var kfmt=function(n){return n>=1000?(n/1000).toFixed(1).replace('.0','')+'k':String(n)};

  var CATS=[
    ['Electronics','laptop',200],['Mobiles and tablets','phone',185],['Audio and wearables','headphones',150],
    ["Women's fashion",'shirt',20],["Men's fashion",'shoe',230],['Bags and wallets','bag',35],
    ['Home and living','lamp',45],['Beauty and health','bottle',330],['Watches','watch',215],
    ['Laptops and PCs','laptop',210],['Footwear','shoe',12],['Lighting and decor','lamp',48],
    ['Grocery','basket',95],['Clothing','shirt',280]
  ];
  var P=[
    {n:'Wireless Earbuds Pro, 30h battery',p:3499,o:5999,c:'Electronics',i:'headphones',h:190,r:4.7,s:5200},
    {n:'Smart Watch Active 2, AMOLED display',p:4999,o:8999,c:'Electronics',i:'watch',h:215,r:4.5,s:3100},
    {n:'Android Phone 8GB/256GB, 50MP camera',p:42999,o:49999,c:'Electronics',i:'phone',h:205,r:4.6,s:1850},
    {n:'Slim Laptop 14-inch, 16GB RAM, 512GB SSD',p:89999,o:104999,c:'Electronics',i:'laptop',h:225,r:4.8,s:640},
    {n:'Air Running Shoes, lightweight mesh',p:3299,o:5499,c:'Fashion',i:'shoe',h:12,r:4.4,s:4200},
    {n:'Leather Handbag, zip closure',p:2799,o:4500,c:'Fashion',i:'bag',h:340,r:4.5,s:2300},
    {n:'Cotton Kurta, 2-piece summer set',p:1899,o:2999,c:'Fashion',i:'shirt',h:30,r:4.3,s:6100},
    {n:'Bedside Table Lamp, warm light',p:1299,o:1999,c:'Home',i:'lamp',h:45,r:4.6,s:1700},
    {n:'Vitamin C Face Serum, 30ml',p:1450,o:2200,c:'Beauty',i:'bottle',h:150,r:4.5,s:3900},
    {n:'Over-ear Headphones, noise reduction',p:6499,o:9999,c:'Electronics',i:'headphones',h:260,r:4.6,s:1250},
    {n:'Fleece Hoodie, unisex winter wear',p:1799,o:2899,c:'Fashion',i:'shirt',h:200,r:4.4,s:5400},
    {n:'Canvas Backpack, 25L laptop sleeve',p:2199,o:3499,c:'Fashion',i:'bag',h:100,r:4.5,s:2900},
    {n:'Fitness Band 6, heart-rate tracking',p:2299,o:3999,c:'Electronics',i:'watch',h:170,r:4.2,s:3600},
    {n:'Ceramic Desk Lamp, touch dimmer',p:1999,o:2999,c:'Home',i:'lamp',h:20,r:4.7,s:980},
    {n:'Hydrating Body Lotion, 400ml',p:899,o:1350,c:'Beauty',i:'bottle',h:300,r:4.3,s:7200},
    {n:'Budget Smartphone 4GB/64GB',p:19999,o:23999,c:'Electronics',i:'phone',h:240,r:4.1,s:4800},
    {n:'Leather Chelsea Boots, handmade',p:5499,o:7999,c:'Fashion',i:'shoe',h:25,r:4.6,s:870},
    {n:'Gaming Laptop 15.6-inch, 144Hz',p:159999,o:179999,c:'Electronics',i:'laptop',h:350,r:4.7,s:310},
    {n:'Hair Oil, argan and castor, 200ml',p:749,o:1100,c:'Beauty',i:'bottle',h:120,r:4.4,s:8300},
    {n:'Shoulder Bag, vegan leather',p:2499,o:3899,c:'Fashion',i:'bag',h:320,r:4.3,s:1900},
    {n:'Wool Shawl, hand-woven',p:2899,o:4500,c:'Fashion',i:'shirt',h:15,r:4.8,s:1500},
    {n:'Floor Lamp, adjustable arm',p:4299,o:6499,c:'Home',i:'lamp',h:60,r:4.4,s:540},
    {n:'Sneakers, everyday white',p:3999,o:5999,c:'Fashion',i:'shoe',h:210,r:4.5,s:3300},
    {n:'Tablet 10-inch, 128GB',p:34999,o:41999,c:'Electronics',i:'phone',h:180,r:4.4,s:760}
  ];
  var disc=function(p){return Math.round((1-p.p/p.o)*100)};
  var card=function(p){
    return '<article class="card"><div class="media" style="--h:'+p.h+'"><span class="badge">-'+disc(p)+'%</span><svg class="ico"><use href="#i-'+p.i+'"/></svg></div>'+
    '<div class="body"><h3 class="name"><a href="#product-'+slugOf(p)+'">'+p.n+'</a></h3><div class="price"><b>Rs. '+fmt(p.p)+'</b><s>Rs. '+fmt(p.o)+'</s></div>'+
    '<div class="meta"><span class="st">&#9733; '+p.r+'</span><span>'+kfmt(p.s)+' sold</span></div>'+
    '<button class="add" type="button" data-n="'+p.n.split(',')[0]+'">Add to cart</button></div></article>';
  };

  /* categories (sidebar, drawer, tiles, top list) */
  var catLinks=CATS.map(function(c){return '<a href="#category-'+slugify(c[0])+'">'+c[0]+'</a>'}).join('');
  $('#sideCats').innerHTML=catLinks; $('#drawerCats').innerHTML=catLinks;
  $('#catGrid').innerHTML=CATS.map(function(c){return '<a class="cat" href="#category-'+slugify(c[0])+'"><span class="c" style="--h:'+c[2]+'"><svg class="ico"><use href="#i-'+c[1]+'"/></svg></span>'+c[0]+'</a>'}).join('');
  var topN=[['Mobiles and tablets','12,480'],['Women’s fashion','48,215'],['Electronics','21,930'],['Home and living','17,604'],['Beauty and health','19,372'],['Footwear','9,845']];
  $('#topCats').innerHTML=topN.map(function(t){return '<li><a href="#category-'+slugify(t[0])+'">'+t[0]+'<span>'+t[1]+' items</span></a></li>'}).join('');
  $('#topBrands').innerHTML=['Nova','Orbit','Zarmeen','Kohsar','Lumen','Sufi Home','Raahi','Tanzeem'].map(function(b){return '<a href="#mall">'+b+'</a>'}).join('');

  /* flash sale */
  $('#flashShelf').innerHTML=P.slice(0,8).map(function(p,k){
    var pct=[78,64,41,23,88,57,70,35][k];
    return card(p).replace('<button class="add"','<div class="bar"><i style="width:'+pct+'%"></i></div><div class="bar-l">'+pct+'% claimed</div><button class="add"');
  }).join('');
  function tick(){
    var n=new Date(),e=new Date(n);e.setHours(23,59,59,999);
    var d=Math.max(0,Math.floor((e-n)/1000));
    var pad=function(x){return String(x).padStart(2,'0')};
    $('#th').textContent=pad(Math.floor(d/3600));$('#tm').textContent=pad(Math.floor(d%3600/60));$('#ts').textContent=pad(d%60);
  }
  tick();setInterval(tick,1000);

  /* mall */
  var B=[['Nova','Mobiles and gadgets',205],['Orbit','Audio and wearables',180],['Zarmeen','Women’s clothing',335],['Kohsar','Footwear and bags',25],['Lumen','Lighting and decor',45],['Sufi Home','Bedding and kitchen',160],['Raahi','Men’s fashion',220],['Tanzeem','Beauty and care',290]];
  $('#brands').innerHTML=B.map(function(b){return '<a class="brand" href="#products" style="--h:'+b[2]+'"><div class="mk" style="--h:'+b[2]+'">'+b[0][0]+'</div><b>'+b[0]+'</b><span>'+b[1]+'</span><em>Official store</em></a>'}).join('');

  /* just for you */
  var shown=10;
  function renderFY(){
    $('#foryouGrid').innerHTML=P.slice(0,shown).map(card).join('');
    $('#loadMore').hidden=shown>=P.length;
  }
  $('#loadMore').addEventListener('click',function(){shown=Math.min(P.length,shown+5);renderFY()});
  renderFY();

  /* trending */
  var trend=P.slice().sort(function(a,b){return (b.s/b.p)-(a.s/a.p)}).slice(0,8);
  $('#trendShelf').innerHTML=trend.map(function(p,k){
    return card(p).replace('<span class="badge">','<span class="badge" style="background:var(--brand);color:var(--brand-ink)">+'+(35+k*13)+'% this week</span><span class="badge" hidden>');
  }).join('');

  /* best sellers */
  var best=P.slice().sort(function(a,b){return b.s-a.s}).slice(0,6);
  $('#rankList').innerHTML=best.map(function(p,k){
    return '<li class="rk"><span class="n">'+(k+1)+'</span><div class="t" style="--h:'+p.h+'"><svg class="ico"><use href="#i-'+p.i+'"/></svg></div>'+
    '<div class="i"><b><a href="#product-'+slugOf(p)+'">'+p.n.split(',')[0]+'</a></b><span>'+kfmt(p.s)+' sold &middot; &#9733; '+p.r+'</span><strong>Rs. '+fmt(p.p)+'</strong></div>'+
    '<button class="add" type="button" data-n="'+p.n.split(',')[0]+'">Add</button></li>';
  }).join('');

  /* product grid with filters */
  var cats=['All','Electronics','Fashion','Home','Beauty'],cur='All';
  function renderChips(){
    $('#chips').innerHTML=cats.map(function(c){return '<button class="chip" type="button" aria-pressed="'+(c===cur)+'" data-c="'+c+'">'+c+'</button>'}).join('');
  }
  function renderProd(){
    var list=P.filter(function(p){return cur==='All'||p.c===cur});
    $('#prodGrid').innerHTML=list.map(card).join('');
  }
  $('#chips').addEventListener('click',function(e){var b=e.target.closest('.chip');if(!b)return;cur=b.dataset.c;renderChips();renderProd()});
  renderChips();renderProd();

  /* offers */
  var O=[['Rs. 300 off','WELCOME300','On your first order above Rs. 2,000.'],['Free delivery','FREESHIP','Any order above Rs. 2,500, all cities.'],['15% off','PAYDAY15','Electronics only, up to Rs. 2,000 off.'],['Rs. 150 back','WALLET150','Pay with JazzCash or Easypaisa and get cashback in your wallet.']];
  $('#offerList').innerHTML=O.map(function(o){return '<div class="offer"><h3>'+o[0]+'</h3><p>'+o[2]+'</p><div class="code"><code>'+o[1]+'</code><button type="button" data-copy="'+o[1]+'">Copy</button></div></div>'}).join('');

  /* global */
  var G=[['Dubai','Electronics and perfume','5-7 days',200],['Istanbul','Home textiles and fashion','7-10 days',0],['Guangzhou','Gadgets and accessories','10-14 days',350],['Seoul','Skincare and beauty','8-12 days',320],['Bangkok','Wellness and snacks','8-12 days',150],['Milan','Footwear and leather','10-14 days',25]];
  $('#globList').innerHTML=G.map(function(g){return '<a class="gl" href="#products" style="--h:'+g[3]+'"><b>'+g[0]+'</b><span>'+g[1]+'</span><em>'+g[2]+'</em></a>'}).join('');

  /* slider */
  var track=$('#track'),slides=track.children,dotsEl=$('#dots'),idx=0,timer;
  Array.prototype.forEach.call(slides,function(_,k){var b=document.createElement('button');b.type='button';b.setAttribute('aria-label','Slide '+(k+1));b.addEventListener('click',function(){go(k,true)});dotsEl.appendChild(b)});
  function mark(){Array.prototype.forEach.call(dotsEl.children,function(b,k){b.setAttribute('aria-current',k===idx)})}
  function go(k,user){idx=(k+slides.length)%slides.length;track.scrollTo({left:idx*track.clientWidth,behavior:'smooth'});mark();if(user)restart()}
  track.addEventListener('scroll',function(){var k=Math.round(track.scrollLeft/track.clientWidth);if(k!==idx){idx=k;mark()}},{passive:true});
  $('#prev').addEventListener('click',function(){go(idx-1,true)});
  $('#next').addEventListener('click',function(){go(idx+1,true)});
  function restart(){clearInterval(timer);if(!matchMedia('(prefers-reduced-motion: reduce)').matches)timer=setInterval(function(){go(idx+1)},5000)}
  mark();restart();

  /* announcement */
  var msgs=['Free delivery on orders above Rs. 2,500 across Pakistan','Cash on delivery available in 400+ cities','Use code WELCOME300 for Rs. 300 off your first order'],mi=0;
  setInterval(function(){mi=(mi+1)%msgs.length;$('#annText').textContent=msgs[mi]},4500);
  $('#annClose').addEventListener('click',function(){$('#announce').hidden=true});

  /* toast */
  var tt;function toast(m){var t=$('#toast');t.textContent=m;t.hidden=false;clearTimeout(tt);tt=setTimeout(function(){t.hidden=true},2200)}

  /* cart */
  var cart=[],saved=[],coupon=null,couponMsg=null,seeded=false;
  (function(){
    var raw=null;try{raw=JSON.parse(localStorage.getItem('chowk-cart-v1'))}catch(x){}
    if(raw&&raw.cart){cart=raw.cart;saved=raw.saved||[];coupon=raw.coupon||null;seeded=!!raw.seeded}
    else{cart=[{n:'Wireless Earbuds Pro',o:'Black',q:1},{n:'Cotton Kurta',o:'M',q:2},{n:'Bedside Table Lamp',o:'Warm white',q:1}];seeded=true}
  })();
  function persist(){try{localStorage.setItem('chowk-cart-v1',JSON.stringify({cart:cart,saved:saved,coupon:coupon,seeded:seeded}))}catch(x){}}
  function prod(n){return P.filter(function(p){return p.n.split(',')[0]===n})[0]}
  if(!Array.isArray(cart))cart=[];if(!Array.isArray(saved))saved=[];cart=cart.filter(function(i){return i&&prod(i.n)});saved=saved.filter(function(i){return i&&prod(i.n)});
  /* ===== Product variants: size x color, with stock per combination ===== */
  var SZ_SHOE=['39','40','41','42','43','44'],SZ_CLO=['S','M','L','XL'];
  var VCFG={
    'Sneakers':{sizes:SZ_SHOE,colors:['Black','White','Red','Blue','Grey'],ds:'41',dc:'White'},
    'Air Running Shoes':{sizes:SZ_SHOE,colors:['Black','White','Red','Blue','Grey'],ds:'41',dc:'Black'},
    'Leather Chelsea Boots':{sizes:SZ_SHOE,colors:['Black','Brown','Tan'],ds:'41',dc:'Black'},
    'Cotton Kurta':{sizes:SZ_CLO,colors:['White','Blue','Maroon','Olive'],ds:'M',dc:'White'},
    'Fleece Hoodie':{sizes:SZ_CLO,colors:['Black','Grey','Blue','Maroon'],ds:'M',dc:'Black'},
    'Wool Shawl':{colors:['Charcoal','Maroon','Camel'],dc:'Charcoal'}
  };
  function vcfg(p){
    var c=VCFG[p.n.split(',')[0]];
    if(!c){
      if(p.i==='shoe')c={sizes:SZ_SHOE,colors:['Black','White','Grey'],ds:'41',dc:'Black'};
      else if(p.i==='shirt')c={sizes:SZ_CLO,colors:['Black','White','Blue'],ds:'M',dc:'Black'};
      else if(p.i==='bag')c={colors:['Black','Brown','Olive'],dc:'Black'};
      else if(p.i==='lamp')c={colors:['Warm white','Black'],dc:'Warm white'};
      else if(p.i==='bottle')c={};
      else c={colors:['Black','Silver','Blue'],dc:'Black'};
    }
    /* a group with fewer than 2 choices is not a choice: it is hidden */
    return{sizes:c.sizes&&c.sizes.length>1?c.sizes:null,colors:c.colors&&c.colors.length>1?c.colors:null,ds:c.ds,dc:c.dc};
  }
  var VM={};
  function vmatrix(i){
    if(VM[i])return VM[i];
    var p=P[i],cf=vcfg(p),tot=STOCK[i],sz=cf.sizes||[''],cl=cf.colors||[''],m={},r=rng(i+41),keys=[],ws=[],sum=0;
    sz.forEach(function(a){cl.forEach(function(b){var out=r()<0.16,w=out?0:0.4+r();keys.push(a+'|'+b);ws.push(w);sum+=w})});
    if(sum===0){ws[0]=1;sum=1}
    keys.forEach(function(k,j){m[k]=tot>0?(ws[j]>0?Math.max(1,Math.round(tot*ws[j]/sum)):0):0});
    var dk=(cf.sizes?(cf.ds||sz[0]):'')+'|'+(cf.colors?(cf.dc||cl[0]):'');
    if(tot>0&&!m[dk])m[dk]=Math.max(1,Math.round(tot*0.2));
    return(VM[i]=m);
  }
  function vstock(p,s,c){
    var cf=vcfg(p);
    if(!cf.sizes&&!cf.colors)return STOCK[P.indexOf(p)];
    return vmatrix(P.indexOf(p))[(cf.sizes?(s||''):'')+'|'+(cf.colors?(c||''):'')]||0;
  }
  function vlabel(s,c){var a=[];if(s)a.push('Size '+s);if(c)a.push(c);return a.join(', ')}
  function pcode(p){return'CH-'+(1000+P.indexOf(p))}
  function imgsFor(p,c){return(p.cimgs&&c&&p.cimgs[c])||p.imgs||null}
  /* stock of one choice (v) given what is already picked on the other group */
  function availOpt(p,cf,kind,v,s,c){
    var o=kind==='s'?(cf.colors?(c?[c]:cf.colors):['']):(cf.sizes?(s?[s]:cf.sizes):['']),t=0;
    o.forEach(function(x){t+=kind==='s'?vstock(p,v,x):vstock(p,x,v)});return t;
  }
  function firstAvail(p,s,c){
    var cf=vcfg(p),ss=cf.sizes||[''],cc=cf.colors||[''],a,b;
    for(a=0;a<ss.length;a++)if(vstock(p,ss[a],c)>0)return{s:ss[a],c:c};
    for(b=0;b<cc.length;b++)if(vstock(p,s,cc[b])>0)return{s:s,c:cc[b]};
    for(a=0;a<ss.length;a++)for(b=0;b<cc.length;b++)if(vstock(p,ss[a],cc[b])>0)return{s:ss[a],c:cc[b]};
    return null;
  }
  function defVar(p){
    var cf=vcfg(p),s=cf.sizes?(cf.ds||cf.sizes[0]):'',c=cf.colors?(cf.dc||cf.colors[0]):'';
    return vstock(p,s,c)>0?{s:s,c:c}:firstAvail(p,s,c);
  }
  function tint(c){return c==='White'?'#8a9aa7':(SW[c]||null)}
  function lightSw(c){var h=SW[c]||'#000000',r=parseInt(h.slice(1,3),16),g=parseInt(h.slice(3,5),16),b=parseInt(h.slice(5,7),16);return(0.299*r+0.587*g+0.114*b)>170}
  function vnorm(it){
    if(!it||typeof it.n!=='string')return null;
    var p=prod(it.n);if(!p)return null;
    var cf=vcfg(p),s=it.s,c=it.c;
    if(s===undefined&&c===undefined&&typeof it.o==='string'&&it.o){/* older saved carts stored one option in "o" */
      if(cf.sizes&&cf.sizes.indexOf(it.o)>-1)s=it.o;else if(cf.colors&&cf.colors.indexOf(it.o)>-1)c=it.o;
    }
    s=cf.sizes?(cf.sizes.indexOf(s)>-1?s:(cf.ds||cf.sizes[0])):'';
    c=cf.colors?(cf.colors.indexOf(c)>-1?c:(cf.dc||cf.colors[0])):'';
    if(vstock(p,s,c)<=0){var a=firstAvail(p,s,c);if(!a)return null;s=a.s;c=a.c}
    var q=parseInt(it.q,10);if(!(q>=1))q=1;q=Math.min(q,10,vstock(p,s,c));
    return{n:it.n,s:s,c:c,o:vlabel(s,c),q:q,id:pcode(p),pr:p.p};
  }
  function find(list,n,o){for(var k=0;k<list.length;k++)if(list[k].n===n&&list[k].o===o)return k;return -1}
  function badge(){$('#cartCount').textContent=cart.reduce(function(s,i){return s+i.q},0)}
  function toastView(msg){
    var t=$('#toast');t.textContent=msg+' ';
    var b=document.createElement('button');b.type='button';b.textContent='View cart';b.setAttribute('data-view-cart','');
    b.style.cssText='margin-left:8px;border:0;background:var(--brand);color:var(--brand-ink);border-radius:99px;padding:4px 12px;font-weight:700';
    t.appendChild(b);t.hidden=false;clearTimeout(tt);tt=setTimeout(function(){t.hidden=true},3500);
  }
  function stk(n,s,c){var p=prod(n);if(!p)return 0;if(s===undefined&&c===undefined)return STOCK[P.indexOf(p)];return vstock(p,s||'',c||'')}
  function addToCart(n,v,qty,silent){
    var p=prod(n);if(!p)return false;
    var s,c;
    if(v&&(v.s!==undefined||v.c!==undefined)){s=v.s||'';c=v.c||''}
    else{var d=defVar(p);if(!d){toast(n+' is out of stock');return false}s=d.s;c=d.c}
    var cf=vcfg(p);
    if(cf.sizes&&!s){toast('Please select a size.');return false}
    if(cf.colors&&!c){toast('Please select a color.');return false}
    var cap=Math.min(10,vstock(p,s,c));
    if(cap<1){toast(n+(vlabel(s,c)?' ('+vlabel(s,c)+')':'')+' is out of stock');return false}
    var o=vlabel(s,c),q=qty||1,k=find(cart,n,o),have=k>-1?cart[k].q:0;
    if(have>=cap){toast(cap>=10?'Maximum 10 per item':'Only '+cap+' in stock');return false}
    q=Math.min(q,cap-have);
    if(k>-1)cart[k].q+=q;else cart.push({n:n,s:s,c:c,o:o,q:q,id:pcode(p),pr:p.p});
    seeded=false;persist();badge();if(!$('#cartView').hidden)renderCart();
    if(!silent)toastView(n+(o?' ('+o+')':'')+' added to cart');
    return true;
  }
  function couponEffect(code,sub,elec){
    if(code==='WELCOME300')return sub>=2000?{disc:300}:{err:'Add Rs. '+fmt(2000-sub)+' more to use WELCOME300.'};
    if(code==='FREESHIP')return sub>=2500?{free:true}:{err:'Add Rs. '+fmt(2500-sub)+' more to use FREESHIP.'};
    if(code==='PAYDAY15')return elec>0?{disc:Math.min(2000,Math.round(elec*0.15))}:{err:'PAYDAY15 works on electronics only.'};
    if(code==='WALLET150')return{disc:150};
    return{err:'This code is not valid.'};
  }
  function calc(){
    var sub=0,list=0,elec=0,u=0;
    cart.forEach(function(it){var p=prod(it.n);sub+=p.p*it.q;list+=p.o*it.q;u+=it.q;if(p.c==='Electronics')elec+=p.p*it.q});
    var disc=0,free=false,err=null;
    if(coupon&&cart.length){var ef=couponEffect(coupon,sub,elec);if(ef.err)err=ef.err;else{disc=ef.disc||0;free=!!ef.free}}
    var ship=!cart.length?0:((sub>=2500||free)?0:locFee());
    return{sub:sub,list:list,disc:disc,ship:ship,total:sub-disc+ship,units:u,err:err,toFree:Math.max(0,2500-sub),free:free};
  }
  function dEst(){
    var a=new Date(),b=new Date(),f={weekday:'short',day:'numeric',month:'short'};
    var ed=etaDays();a.setDate(a.getDate()+ed[0]);b.setDate(b.getDate()+ed[1]);
    return a.toLocaleDateString('en-PK',f)+' to '+b.toLocaleDateString('en-PK',f);
  }
  function ic(id){return '<svg class="ico" aria-hidden="true"><use href="#i-'+id+'"/></svg>'}
  function tileHtml(p,col){
    var im=imgsFor(p,col),inner=(im&&im[0])?'<img src="'+im[0]+'" alt="" loading="lazy" data-ic="'+p.i+'">':ic(p.i);
    return '<a class="ci-img" href="#product-'+slugOf(p)+'" style="--h:'+p.h+'" tabindex="-1" aria-hidden="true">'+inner+'</a>';
  }
  function itemHtml(it,k,isSaved){
    var p=prod(it.n),cf=vcfg(p),d=disc(p),st=vstock(p,it.s||'',it.c||''),cap=Math.min(10,st);
    var title='<h3><a href="#product-'+slugOf(p)+'">'+it.n+'</a></h3>',variant='';
    if(cf.sizes){
      variant+=isSaved?'<span class="chip-v">Size: <b>'+esc(it.s)+'</b></span>':
        '<label class="chip-v">Size<select data-opt="'+k+'" data-kind="s" aria-label="Size for '+it.n+'">'+cf.sizes.map(function(v){var na=vstock(p,v,it.c||'')<=0&&v!==it.s;return'<option value="'+v+'"'+(v===it.s?' selected':'')+(na?' disabled':'')+'>'+v+(na?' (unavailable)':'')+'</option>'}).join('')+'</select></label>';
    }
    if(cf.colors){
      var dot='<i class="sdot" style="--c:'+(SW[it.c]||'#999')+'"></i>';
      variant+=isSaved?'<span class="chip-v">'+dot+'Color: <b>'+esc(it.c)+'</b></span>':
        '<label class="chip-v">'+dot+'Color<select data-opt="'+k+'" data-kind="c" aria-label="Color for '+it.n+'">'+cf.colors.map(function(v){var na=vstock(p,it.s||'',v)<=0&&v!==it.c;return'<option value="'+v+'"'+(v===it.c?' selected':'')+(na?' disabled':'')+'>'+v+(na?' (unavailable)':'')+'</option>'}).join('')+'</select></label>';
    }
    var unit='<div class="ci-unit"><b>Rs. '+fmt(p.p)+'</b><s>Rs. '+fmt(p.o)+'</s><span class="off">-'+d+'%</span></div>';
    var low=st<=10?'<div class="lowst">Only '+st+' left in stock</div>':'';
    var main='<div class="ci-main">'+title+(variant?'<div class="ci-var">'+variant+'</div>':'')+unit+low+'</div>';
    if(isSaved){
      return '<article class="ci">'+tileHtml(p,it.c)+main+'<div class="ci-foot"><div class="ci-actions"><button class="ibtn pri" type="button" data-move="'+k+'" aria-label="Move '+it.n+' to cart">'+ic('cart')+'Move to cart</button><button class="ibtn rm" type="button" data-rmsaved="'+k+'" aria-label="Remove '+it.n+' from saved items">'+ic('trash')+'Remove</button></div></div></article>';
    }
    var side='<div class="ci-side"><b>Rs. '+fmt(p.p*it.q)+'</b>'+(it.q>1?'<small>'+it.q+' &times; Rs. '+fmt(p.p)+'</small>':'')+(p.o>p.p?'<span class="sv">You save Rs. '+fmt((p.o-p.p)*it.q)+'</span>':'')+'</div>';
    var qty='<div class="qty" role="group" aria-label="Quantity for '+it.n+'"><button type="button" data-q="'+k+'" data-d="-1" aria-label="Decrease quantity of '+it.n+'"'+(it.q<=1?' disabled':'')+'>&minus;</button><output aria-live="polite">'+it.q+'</output><button type="button" data-q="'+k+'" data-d="1" aria-label="Increase quantity of '+it.n+'"'+(it.q>=cap?' disabled':'')+'>+</button></div>';
    var acts='<div class="ci-actions"><button class="ibtn" type="button" data-save="'+k+'" aria-label="Save '+it.n+' for later">'+ic('heart')+'Save for later</button><button class="ibtn rm" type="button" data-rm="'+k+'" aria-label="Remove '+it.n+' from cart">'+ic('trash')+'Remove</button></div>';
    return '<article class="ci">'+tileHtml(p,it.c)+main+side+'<div class="ci-foot">'+qty+acts+'</div></article>';
  }
  function summaryHtml(T){
    var cm='';
    if(coupon&&!T.err)cm='<div class="cmsg ok" role="status">'+coupon+' applied. <button class="lk" type="button" data-clear-coupon>Remove</button></div>';
    else if(coupon&&T.err)cm='<div class="cmsg bad" role="alert">'+T.err+' <button class="lk" type="button" data-clear-coupon>Remove</button></div>';
    else if(couponMsg)cm='<div class="cmsg bad" role="alert">'+couponMsg+'</div>';
    var saving=T.list-T.sub+T.disc;
    return '<aside class="summary" aria-labelledby="sumh"><h2 id="sumh">Order summary</h2>'+
      '<div><label class="cl" for="cpn">Coupon code</label><div class="coupon"><input id="cpn" type="text" placeholder="Enter code" autocomplete="off" autocapitalize="characters" spellcheck="false"><button class="btn" type="button" data-apply>Apply</button></div>'+cm+'</div>'+
      '<dl class="rows">'+
      '<div class="sr"><dt>Subtotal ('+T.units+(T.units===1?' item':' items')+')</dt><dd>Rs. '+fmt(T.sub)+'</dd></div>'+
      '<div class="sr'+(T.disc?' cut':'')+'"><dt>Discount</dt><dd>'+(T.disc?'- Rs. '+fmt(T.disc):'Rs. 0')+'</dd></div>'+
      '<div class="sr'+(T.ship?'':' cut')+'"><dt>Delivery</dt><dd>'+(T.ship?'Rs. '+fmt(T.ship):'Free')+'</dd></div>'+
      '<div class="sr tot"><dt>Grand total</dt><dd>Rs. '+fmt(T.total)+'</dd></div></dl>'+
      (saving>0?'<div class="saving">'+ic('check')+'You save Rs. '+fmt(saving)+' on this order</div>':'')+
      '<button class="checkout" type="button" data-checkout>'+ic('lock')+'Proceed to checkout</button>'+
      '<button class="back" type="button" data-go-home>'+ic('back')+'Continue shopping</button>'+
      '<div class="assure"><div class="est">'+ic('truck')+'<span><b>Estimated delivery</b><br>'+dEst()+locTag()+'</span></div>'+
      '<div class="secure">'+ic('lock')+'<span><b>Secure payment</b><br>Your details are encrypted. Cash on delivery is also available.</span></div></div></aside>';
  }
  function renderCart(){
    var T=calc(),n=T.units;
    var h='<div class="wrap cartpage"><header class="chead"><ol class="steps" aria-label="Checkout progress"><li class="on" aria-current="step">Cart</li><li>Checkout</li><li>Confirmation</li></ol><h1>My Cart<span>'+n+(n===1?' item':' items')+'</span></h1></header>';
    if(!cart.length){
      var sug=P.filter(function(q,i){return STOCK[i]>0}).sort(function(a,b){return b.s-a.s}).slice(0,4);
      h+='<div class="empty"><span class="eico">'+ic('cart')+'</span><h2>Your cart is empty</h2><p>Products you add will show up here, so you can review them before checkout.</p><button class="btn solid" type="button" data-go-home>Start shopping</button></div>';
      h+='<section class="saved-sec"><h2>Popular right now</h2><div class="grid">'+sug.map(card).join('')+'</div></section>';
    }else{
      var pct=Math.min(100,Math.round(T.sub/2500*100)),unlocked=(T.sub>=2500||T.free);
      h+='<div class="clayout"><div class="citems"><div class="meter"><p>'+ic('truck')+'<span>'+(unlocked?'<b>Free delivery</b> is applied to this order.':'Add <b>Rs. '+fmt(T.toFree)+'</b> more to get free delivery.')+'</span></p><div class="mtrack" role="progressbar" aria-label="Progress to free delivery" aria-valuemin="0" aria-valuemax="100" aria-valuenow="'+pct+'"><i style="width:'+(unlocked?100:pct)+'%"></i></div></div>'+
        cart.map(function(it,k){return itemHtml(it,k,false)}).join('');
      if(seeded)h+='<p class="note">These are sample items so you can try the cart. Change or remove them any time.</p>';
      h+='</div>'+summaryHtml(T)+'</div>';
    }
    if(saved.length)h+='<section class="saved-sec" aria-label="Saved for later"><h2>Saved for later <span>('+saved.length+')</span></h2><div class="saved-grid">'+saved.map(function(it,k){return itemHtml(it,k,true)}).join('')+'</div></section>';
    if(cart.length)h+='<div class="mbar"><div><small>Grand total</small><b>Rs. '+fmt(T.total)+'</b></div><button class="checkout" type="button" data-checkout>'+ic('lock')+'Checkout</button></div>';
    $('#cartView').innerHTML=h+'</div>';
  }
  function toastUndo(msg){
    var t=$('#toast');t.textContent=msg+' ';
    var b=document.createElement('button');b.type='button';b.textContent='Undo';b.setAttribute('data-undo','');
    b.style.cssText='margin-left:8px;border:0;background:var(--brand);color:var(--brand-ink);border-radius:99px;padding:4px 12px;font-weight:700';
    t.appendChild(b);t.hidden=false;clearTimeout(tt);tt=setTimeout(function(){t.hidden=true},5000);
  }
  var undoItem=null;
  function toTop(){
    var s=document.scrollingElement||document.documentElement;s.scrollTop=0;document.body.scrollTop=0;window.scrollTo(0,0);
    var h=document.querySelector('header.top');if(h&&h.scrollIntoView)h.scrollIntoView({block:'start'});
  }
  function showCart(){
    $('#drawerScrim').hidden=true;$('#authScrim').hidden=true;
    $('#home').hidden=true;$('#ordersView').hidden=true;$('#adminView').hidden=true;$('#categoryView').hidden=true;$('#accountView').hidden=true;$('#productView').hidden=true;$('#authPageView').hidden=true;$('#cartView').hidden=false;document.title='My Cart | Chowk';
    try{renderCart()}catch(x){$('#cartView').innerHTML='<div class="wrap cartpage"><div class="empty"><h2>Could not load your cart</h2><button class="btn solid" type="button" data-go-home>Back to shop</button></div></div>'}
    toTop();
  }
  function showHome(){
    if($('#cartView').hidden&&$('#productView').hidden&&$('#ordersView').hidden&&$('#adminView').hidden&&$('#categoryView').hidden&&$('#accountView').hidden&&$('#authPageView').hidden)return;
    $('#ordersView').hidden=true;$('#adminView').hidden=true;$('#categoryView').hidden=true;$('#accountView').hidden=true;$('#cartView').hidden=true;$('#productView').hidden=true;$('#authPageView').hidden=true;$('#home').hidden=false;document.title='Chowk Marketplace';
  }
  function after(){
    var a=document.activeElement,sel=null;
    if(a&&a.dataset&&$('#cartView').contains(a)){
      if(a.dataset.q!==undefined)sel='[data-q="'+a.dataset.q+'"][data-d="'+a.dataset.d+'"]';
      else if(a.dataset.opt!==undefined)sel='[data-opt="'+a.dataset.opt+'"][data-kind="'+a.dataset.kind+'"]';
    }
    persist();badge();renderCart();
    if(sel){var el=$('#cartView '+sel);if(el&&!el.disabled)el.focus()}
  }
  $('#cartView').addEventListener('click',function(e){
    var t=e.target.closest('button');if(!t)return;
    if(t.hasAttribute('data-go-home')){showHome();toTop();return}
    if(t.dataset.q!==undefined){var it=cart[+t.dataset.q];if(!it)return;var nq=it.q+(+t.dataset.d);if(nq<1||nq>Math.min(10,stk(it.n,it.s,it.c)))return;it.q=nq;seeded=false;after();return}
    if(t.dataset.rm!==undefined){var ri=+t.dataset.rm,r=cart.splice(ri,1)[0];undoItem={it:r,idx:ri};seeded=false;after();toastUndo(r.n+' removed.');return}
    if(t.dataset.save!==undefined){var s=cart.splice(+t.dataset.save,1)[0],j=find(saved,s.n,s.o);if(j>-1)saved[j].q=Math.min(10,saved[j].q+s.q);else saved.push(s);seeded=false;after();toast('Saved for later');return}
    if(t.dataset.move!==undefined){var m=saved.splice(+t.dataset.move,1)[0],j2=find(cart,m.n,m.o);if(j2>-1)cart[j2].q=Math.min(10,cart[j2].q+m.q);else cart.push(m);seeded=false;after();toast('Moved to cart');return}
    if(t.dataset.rmsaved!==undefined){saved.splice(+t.dataset.rmsaved,1);after();return}
    if(t.hasAttribute('data-apply')){
      var code=($('#cpn').value||'').trim().toUpperCase();
      if(!code){couponMsg='Enter a coupon code.'}
      else{
        var sub=0,elec=0;cart.forEach(function(i){var p=prod(i.n);sub+=p.p*i.q;if(p.c==='Electronics')elec+=p.p*i.q});
        var ef=couponEffect(code,sub,elec);
        if(ef.err){couponMsg=ef.err}else{coupon=code;couponMsg=null}
      }
      after();return;
    }
    if(t.hasAttribute('data-clear-coupon')){coupon=null;couponMsg=null;after();return}
    if(t.hasAttribute('data-checkout')){if(!locCheckout())return;placeDemoOrder();return}
  });
  $('#cartView').addEventListener('change',function(e){
    var s=e.target.closest('select[data-opt]');if(!s)return;
    var k=+s.dataset.opt,it=cart[k];if(!it)return;
    var p=prod(it.n),kind=s.dataset.kind;
    if(vstock(p,kind==='s'?s.value:it.s,kind==='c'?s.value:it.c)<=0){toast('That combination is unavailable.');after();return}
    it[kind]=s.value;it.o=vlabel(it.s,it.c);it.id=pcode(p);it.pr=p.p;
    var cp=Math.min(10,vstock(p,it.s,it.c));if(it.q>cp)it.q=cp;
    var j=find(cart,it.n,it.o);
    if(j>-1&&j!==k){cart[j].q=Math.min(cp,cart[j].q+it.q);cart.splice(k,1)}
    seeded=false;after();
  });
  $('#cartView').addEventListener('keydown',function(e){
    if(e.key==='Enter'&&e.target.id==='cpn'){e.preventDefault();var b=$('#cartView [data-apply]');if(b)b.click()}
  });
  document.addEventListener('click',function(e){
    if(e.target.closest('[data-undo]')){
      if(undoItem){var u=undoItem;undoItem=null;var j=find(cart,u.it.n,u.it.o);
        if(j>-1)cart[j].q=Math.min(10,cart[j].q+u.it.q);else cart.splice(Math.min(u.idx,cart.length),0,u.it);
        persist();badge();if(!$('#cartView').hidden)renderCart();$('#toast').hidden=true}
      return}
    if(e.target.closest('[data-view-cart]')){showCart();return}
    var a=e.target.closest('a[href^="#"]');
    var hr=a&&a.getAttribute('href');
    if(a&&hr!=='#footer'&&hr.indexOf('#product-')!==0&&hr.indexOf('#category-')!==0&&(!$('#cartView').hidden||!$('#productView').hidden||!$('#categoryView').hidden||!$('#accountView').hidden))showHome();
  });
  /* ---- Product details page: data (same order as the P array) ---- */
  var STOCK=[240,58,14,6,120,35,300,9,420,47,85,60,150,22,500,75,18,12,380,41,26,0,64,19];
  var DESC=[
    'True wireless earbuds with 13mm drivers and active noise reduction. The charging case gives 30 hours in total. Touch controls and a low-latency gaming mode are included.',
    'A 1.43-inch AMOLED display with heart-rate and SpO2 tracking. It has over 100 sport modes and about 7 days of battery. Works with Android and iPhone.',
    'A 6.7-inch 120Hz display, a 50MP main camera with stabilisation and a 5000mAh battery. 33W fast charging and dual SIM support.',
    'A 1.3kg, 14-inch laptop with 16GB RAM, a 512GB SSD and an anti-glare full-HD screen. Built for study, office work and travel.',
    'Lightweight breathable mesh upper with a cushioned foam midsole. The rubber outsole grips well on roads and gym floors.',
    'A structured handbag in soft faux leather with a zip closure and two inner pockets. The shoulder strap is detachable.',
    'A breathable two-piece summer set with a straight-cut kurta and matching trousers. Soft cotton that is easy to wash.',
    'A compact lamp with a warm 2700K LED and a fabric shade. It gives a soft glow for reading or winding down at night.',
    'A lightweight 30ml serum with 10% vitamin C and hyaluronic acid. It brightens dull skin and supports hydration. Use morning or night.',
    'Foldable over-ear headphones with hybrid noise reduction and 40mm drivers. Up to 50 hours of playback, wired or Bluetooth.',
    'Brushed fleece lining, a kangaroo pocket and a ribbed hem. A warm, relaxed unisex hoodie for cold evenings.',
    'A 25L backpack in heavy canvas with a padded 15-inch laptop sleeve. The base is water resistant and there are two bottle pockets.',
    'A slim band with continuous heart-rate tracking, step and sleep monitoring. The battery lasts up to 14 days.',
    'A desk lamp with a glazed ceramic base and touch dimming across three levels. A USB port on the base charges your phone.',
    'A daily body lotion with shea butter and glycerin for 24-hour moisture. Absorbs quickly with a light, clean scent.',
    'A dependable 4GB/64GB phone with a 6.5-inch display and a 13MP camera. The 5000mAh battery lasts about two days.',
    'Handmade Chelsea boots in full-grain leather with elastic side panels. Cushioned insole and a stitched rubber sole.',
    'A 15.6-inch 144Hz laptop with dedicated graphics, 16GB RAM and a 1TB SSD. Made for gaming and video editing.',
    'A 200ml blend of argan and castor oil that conditions the scalp and reduces breakage. Apply before washing for extra shine.',
    'A slouchy shoulder bag in vegan leather with a magnetic closure. Interior zip pocket and an adjustable strap.',
    'A hand-woven wool shawl that is soft and warm without being heavy. The 200 x 70cm size works as a wrap or a scarf.',
    'An adjustable-arm floor lamp with a weighted steel base and a dimmable warm LED. Good for reading corners and living rooms.',
    'Everyday white sneakers in synthetic leather with a cushioned insole. The upper wipes clean in seconds.',
    'A 10-inch tablet with a 2K display, 128GB storage and four speakers. Good for classes, video and reading.'
  ];
  var FEAT=[
    ['Up to 8 hours per charge, 30 hours with case','Bluetooth 5.3 with one-step pairing','IPX5 sweat and splash resistance'],
    ['Always-on AMOLED display','Heart rate, SpO2 and sleep tracking','5 ATM water resistance'],
    ['8GB RAM and 256GB storage','50MP camera with stabilisation','33W fast charging'],
    ['Backlit keyboard','Up to 10 hours of battery','Windows 11 Home included'],
    ['Breathable knit mesh','Cushioned foam midsole','Slip-resistant outsole'],
    ['Zip closure and two inner pockets','Detachable shoulder strap','Fits a 10-inch tablet'],
    ['100% cotton fabric','Kurta and trouser set','Colourfast and machine washable'],
    ['Warm 2700K LED bulb included','Low power use, about 5W','Stable weighted base'],
    ['10% vitamin C with hyaluronic acid','Fragrance free','Dermatologist tested'],
    ['Hybrid noise reduction','Up to 50 hours of playback','Foldable with a carry pouch'],
    ['Brushed fleece lining','Adjustable drawstring hood','Unisex relaxed fit'],
    ['Padded laptop sleeve','Water-resistant base','Two side bottle pockets'],
    ['14-day battery','24/7 heart-rate tracking','Call and message alerts'],
    ['Touch dimmer with 3 levels','USB charging port','Glazed ceramic base'],
    ['Shea butter and glycerin','24-hour moisture','Non-greasy finish'],
    ['6.5-inch HD+ display','5000mAh battery','Storage expandable to 512GB'],
    ['Full-grain leather upper','Elastic side panels','Stitched rubber sole'],
    ['144Hz display','Dedicated graphics card','1TB NVMe SSD'],
    ['Argan and castor oil blend','Reduces breakage','No mineral oil'],
    ['Magnetic closure','Interior zip pocket','Adjustable strap'],
    ['Hand-woven wool blend','200 x 70cm','Dry clean recommended'],
    ['Adjustable arm and head','Dimmable warm LED','Weighted steel base'],
    ['Wipe-clean upper','Cushioned insole','Cupsole with strong grip'],
    ['2K 10-inch display','128GB storage with microSD slot','Four speakers']
  ];
  var SW={'Black':'#1f2933','Silver':'#a8b3bd','Blue':'#2f6fd6','Brown':'#8a5a3b','Olive':'#6b7a3a','Warm white':'#f2d9a0','Charcoal':'#3b4350','Maroon':'#7a1f2e','Camel':'#c19a6b','White':'#ffffff','Red':'#d32f2f','Grey':'#8b949e','Tan':'#c8a27a'};
  var REV={
    headphones:['Sound is clear and the bass is better than I expected at this price.','Battery lasts all day and pairing took a few seconds.','Comfortable for long calls. The microphone picks up my voice well.','Arrived in two days, well packed. Noise reduction works on the bus.','Good value. The case is slightly bulky but that is my only complaint.'],
    watch:['The display is bright outdoors and the strap is comfortable.','Battery lasts almost a week with heart-rate tracking on.','Step count matches my phone closely. Notifications arrive instantly.','Setup was easy and the sports modes are useful at the gym.','Looks more expensive than it is. The charging cable is a bit short.'],
    phone:['The camera is sharp in daylight and the screen scrolls smoothly.','Battery easily lasts a full day with heavy use.','Fast charging works as promised and the signal is strong.','Good performance for the price. Original box with all accessories.','Set up with my SIM in minutes. Speakers are loud and clear.'],
    laptop:['Fast start-up and the keyboard is comfortable for long typing.','Light enough to carry to university every day.','The screen is clear and the fans stay quiet during normal work.','Battery gets me through a work day. Packaging was very secure.','Great for the price. Runs my editing software without trouble.'],
    shoe:['True to size and comfortable from the first wear.','Light on the foot with good grip on wet floors.','Stitching looks neat and the colour matches the photos.','Wore them for a full day of walking with no pain.','Good quality for the price. Delivered in three days.'],
    bag:['Stitching and zips feel sturdy. Looks just like the pictures.','Plenty of room for my daily things and a small tablet.','The strap is comfortable and the colour is lovely.','Good quality for the price. Packed carefully.','I get compliments every time I carry it.'],
    shirt:['The fabric is soft and the fit is exactly as described.','Colour did not fade after the first wash.','Warm without feeling heavy. Stitching is neat.','The size chart was accurate. Delivered quickly.','Great quality for the price. Would buy again.'],
    lamp:['Warm light that is easy on the eyes at night.','Looks great on my desk and the base is stable.','Easy to set up. The dimmer works smoothly.','Bright enough for reading and not too harsh.','Packed well and works perfectly. Nice finish.'],
    bottle:['Skin feels fresh and smooth after two weeks of use.','Absorbs quickly and the scent is light.','No irritation on my sensitive skin. The pump works well.','Original product, sealed properly. Good size for the price.','I noticed a difference in a few weeks. Will reorder.'],
    hair:['Less hair fall after a month of regular use.','Light oil that does not feel sticky. The smell is mild.','My hair looks shinier and feels softer.','Original product, sealed. Good value for 200ml.','Helped with dryness and is easy to wash out.'],
    shawl:['Soft and warm, not itchy at all.','Beautiful weave and the colour matches the photos.','Large enough to wrap twice. Arrived carefully folded.','A great gift. Quality is better than the market near me.','Kept me warm all evening without feeling heavy.'],
    tablet:['The screen is sharp for videos and reading.','Light enough to hold for long study sessions.','Speakers are loud and the battery lasts all day.','Smooth for classes and notes. Came well packed.','A good value tablet for the whole family.']
  };
  var NAMES=['Ayesha K.','Hamza R.','Sana M.','Bilal A.','Fatima Z.','Usman T.','Hira S.','Ali Raza','Maryam N.','Zain U.','Noor F.','Tariq H.'];
  var CITIES=['Karachi','Lahore','Islamabad','Faisalabad','Multan','Peshawar','Quetta','Hyderabad'];
  var WHEN=['3 days ago','1 week ago','2 weeks ago','3 weeks ago','1 month ago','2 months ago'];
  var pd=null;

  function slugify(s){return String(s).toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'')}
  function slugOf(p){return slugify(p.n.split(',')[0])}
  function bySlug(s){return P.filter(function(p){return slugOf(p)===s})[0]}
  function rng(seed){var s=seed*9301+49297;return function(){s=(s*9301+49297)%233280;return s/233280}}
  function stars(r){var f=Math.round(r);return '<span class="stars" role="img" aria-label="'+r+' out of 5 stars">'+'★★★★★'.slice(0,f)+'<i>'+'★★★★★'.slice(0,5-f)+'</i></span>'}
  function revKey(p){if(p.n.indexOf('Hair Oil')===0)return'hair';if(p.n.indexOf('Wool Shawl')===0)return'shawl';if(p.n.indexOf('Tablet')===0)return'tablet';return p.i}
  function reviewsFor(i){
    var p=P[i],r=p.r,n=Math.max(12,Math.round(p.s*0.11));
    var T=Math.min(0.5,(5-r)*0.55),l3=0.5*T,l2=0.28*T,l1=0.22*T;
    var a=r-(3*l3+2*l2+l1)-4*(1-T);a=Math.max(0,Math.min(1-T,a));
    var rnd=rng(i+3),pool=REV[revKey(p)].slice(),list=[];
    var sc=r>=4.6?[5,5,4,5]:r>=4.3?[5,4,5,4]:[4,5,3,4];
    for(var k=0;k<4;k++){
      var j=Math.floor(rnd()*pool.length),txt=pool.splice(j,1)[0];
      list.push({name:NAMES[Math.floor(rnd()*NAMES.length)],city:CITIES[Math.floor(rnd()*CITIES.length)],when:WHEN[Math.min(5,k+Math.floor(rnd()*2))],stars:sc[k],txt:txt});
    }
    return{n:n,share:[a,1-T-a,l3,l2,l1],list:list};
  }
  function slideSvg(p,k,col){
    var im=imgsFor(p,col);
    if(im&&im[k])return '<img src="'+im[k]+'" alt="'+p.n.split(',')[0]+(col?' in '+col:'')+'" style="width:100%;height:100%;object-fit:cover">';
    var ic='#i-'+p.i,g='';
    if(k===0)g='<circle cx="50" cy="52" r="34" fill="var(--sw)" opacity=".14" stroke="none"/><use href="'+ic+'" x="24" y="24" width="52" height="52"/>';
    if(k===1)g='<ellipse cx="50" cy="82" rx="26" ry="4" fill="var(--sw)" opacity=".22" stroke="none"/><g transform="rotate(-9 50 50)"><use href="'+ic+'" x="21" y="19" width="58" height="58"/></g>';
    if(k===2)g='<circle cx="50" cy="50" r="46" fill="var(--sw)" opacity=".1" stroke="none"/><use href="'+ic+'" x="-14" y="-14" width="128" height="128"/>';
    if(k===3)g='<rect x="12" y="28" width="76" height="46" rx="6" fill="var(--sw)" opacity=".12" stroke="none"/><use href="'+ic+'" x="18" y="34" width="34" height="34"/><rect x="60" y="38" width="22" height="4" rx="2" fill="currentColor" opacity=".4" stroke="none"/><rect x="60" y="47" width="16" height="4" rx="2" fill="currentColor" opacity=".3" stroke="none"/><rect x="60" y="56" width="20" height="4" rx="2" fill="currentColor" opacity=".3" stroke="none"/>';
    return '<svg class="ico" viewBox="0 0 100 100" aria-hidden="true">'+g+'</svg>';
  }
  function pdColor(p,cf){
    if(!cf.colors)return'';
    var ord=[cf.dc].concat(cf.colors);
    for(var k=0;k<ord.length;k++)if(ord[k]&&availOpt(p,cf,'c',ord[k],'','')>0)return ord[k];
    return cf.dc||cf.colors[0];
  }
  function pdComplete(){var cf=vcfg(pd.p);return(!cf.sizes||!!pd.s)&&(!cf.colors||!!pd.c)}
  function pdCap(){var p=pd.p;return Math.max(1,Math.min(10,pdComplete()?vstock(p,pd.s,pd.c):STOCK[P.indexOf(p)]))}
  function pdValidate(){
    var cf=vcfg(pd.p),bad='';
    if(cf.sizes&&!pd.s)bad+='s';
    if(cf.colors&&!pd.c)bad+='c';
    if(!bad)return true;
    pd.err=bad;renderPdp();
    toast(bad==='sc'?'Please select a size and a color.':bad==='s'?'Please select a size.':'Please select a color.');
    var g=document.getElementById('grp-'+bad.charAt(0));if(g&&g.scrollIntoView)g.scrollIntoView({behavior:'smooth',block:'center'});
    return false;
  }
  function pdGroup(kind){
    var p=pd.p,cf=vcfg(p),list=kind==='s'?cf.sizes:cf.colors,label=kind==='s'?'Size':'Color',cur=kind==='s'?pd.s:pd.c,bad=pd.err&&pd.err.indexOf(kind)>-1;
    var btns=list.map(function(v){
      var n=availOpt(p,cf,kind,v,pd.s,pd.c),dis=n<=0?' disabled title="Unavailable"':'',on=(v===cur);
      if(kind==='s')return'<button type="button" class="ov" data-os="'+v+'" aria-pressed="'+on+'"'+dis+'>'+v+'</button>';
      return'<button type="button" class="ov sw" data-oc="'+v+'" aria-pressed="'+on+'" aria-label="'+v+(n<=0?' (unavailable)':'')+'" title="'+v+(n<=0?' (unavailable)':'')+'" style="--c:'+(SW[v]||'#999')+';--ck:'+(lightSw(v)?'#10231F':'#fff')+'"'+(n<=0?' disabled':'')+'></button>';
    }).join('');
    return'<div class="optg'+(bad?' bad':'')+'" id="grp-'+kind+'" role="group" aria-label="Select '+label.toLowerCase()+'"><div class="optl">'+label+': <b>'+(cur||'Select a '+label.toLowerCase())+'</b></div><div class="optv">'+btns+'</div>'+(bad?'<p class="ferr" role="alert">Please select a '+label.toLowerCase()+'.</p>':'')+'</div>';
  }
  function renderPdp(){
    var p=pd.p,i=P.indexOf(p),name=p.n.split(',')[0],sub=p.n.indexOf(',')>-1?p.n.slice(p.n.indexOf(',')+1).trim():'';
    var cf=vcfg(p),comp=pdComplete(),st=comp?vstock(p,pd.s,pd.c):STOCK[i],cap=pdCap(),rv=reviewsFor(i),d=disc(p);
    if(pd.q>cap)pd.q=cap;
    var sw=(pd.c&&tint(pd.c))||'hsl('+p.h+' 55% 45%)';
    var CAP=['Front view','Three-quarter view','Close-up','In the box'];
    var first=DESC[i].split('. ')[0];if(first.slice(-1)!=='.')first+='.';
    var dis=st===0?' disabled':'';
    var h='<div class="wrap pdp">';
    h+='<nav class="crumbs" aria-label="Breadcrumb"><button class="lk" type="button" data-go-home>Home</button><span>&rsaquo;</span><button class="lk" type="button" data-go-home>'+p.c+'</button><span>&rsaquo;</span><b>'+name+'</b></nav>';
    h+='<div class="pgrid"><div class="gallery" style="--sw:'+sw+'">';
    h+='<div class="stage">'+slideSvg(p,pd.slide,pd.c)+'<span class="badge">-'+d+'%</span><span class="cap">'+CAP[pd.slide]+(pd.c?' &middot; '+pd.c:'')+'</span><button class="garrow l" type="button" data-gstep="-1" aria-label="Previous image">&#8249;</button><button class="garrow r" type="button" data-gstep="1" aria-label="Next image">&#8250;</button></div>';
    h+='<div class="thumbs">'+[0,1,2,3].map(function(k){return '<button class="thumb" type="button" data-slide="'+k+'" aria-pressed="'+(k===pd.slide)+'" aria-label="Show image '+(k+1)+'">'+slideSvg(p,k,pd.c)+'</button>'}).join('')+'</div></div>';
    h+='<div class="pinfo"><div><h1>'+name+'</h1>'+(sub?'<p class="psub">'+sub+'</p>':'')+'</div>';
    h+='<div class="prate">'+stars(p.r)+'<b>'+p.r+'</b><button class="lk" type="button" data-jump="reviews">'+fmt(rv.n)+' reviews</button><span>&middot; '+kfmt(p.s)+' sold</span></div>';
    h+='<div><div class="pprice"><b>Rs. '+fmt(p.p)+'</b><s>Rs. '+fmt(p.o)+'</s><span class="pdisc">-'+d+'%</span></div><div class="psave">You save Rs. '+fmt(p.o-p.p)+' per item</div></div>';
    h+='<p>'+first+'</p>';
    if(cf.sizes)h+=pdGroup('s');
    if(cf.colors)h+=pdGroup('c');
    h+=comp?(st===0?'<div class="stock out">Out of stock</div>':st<=10?'<div class="stock low">Only '+st+' left in stock. Order soon.</div>':'<div class="stock in">In stock</div>'):
      (STOCK[i]===0?'<div class="stock out">Out of stock</div>':'<div class="stock pend">Select '+(cf.sizes&&!pd.s?'a size':'a color')+' to see availability</div>');
    h+='<div class="optg"><div class="optl">Quantity</div><div class="qty"><button type="button" data-qd="-1" aria-label="Decrease quantity"'+(pd.q<=1||st===0?' disabled':'')+'>&minus;</button><output aria-live="polite">'+pd.q+'</output><button type="button" data-qd="1" aria-label="Increase quantity"'+(pd.q>=cap||st===0?' disabled':'')+'>+</button></div></div>';
    h+='<div class="buyrow"><button class="btn-add" type="button" data-pdp-add'+dis+'>Add to cart</button><button class="btn-buy" type="button" data-pdp-buy'+dis+'>Buy now</button></div>';
    h+='<div class="trust"><div><svg class="ico"><use href="#i-truck"/></svg><span><b>Estimated delivery</b><br>'+dEst()+locTag()+'</span></div><div><svg class="ico"><use href="#i-lock"/></svg><span><b>Secure payment</b><br>Cash on delivery and online payment. '+(p.c==='Electronics'?'1 year brand warranty.':'7-day easy returns.')+'</span></div></div>';
    h+='</div></div>';
    var specs=[['Category',p.c],['Product code','CH-'+(1000+i)],['Warranty',p.c==='Electronics'?'1 year brand warranty':'7-day easy returns'],['Delivery',etaText()],['Rating',p.r+' out of 5 ('+fmt(rv.n)+' ratings)']];
    if(cf.sizes)specs.push(['Sizes',cf.sizes.join(', ')]);
    if(cf.colors)specs.push(['Colors',cf.colors.join(', ')]);
    h+='<section class="psec"><h2>Product description</h2><p>'+DESC[i]+'</p><ul class="feat">'+FEAT[i].map(function(f){return '<li>'+f+'</li>'}).join('')+'</ul><div class="tw"><table class="spec"><tbody>'+specs.map(function(s){return '<tr><td>'+s[0]+'</td><td>'+s[1]+'</td></tr>'}).join('')+'</tbody></table></div></section>';
    h+='<section class="psec" id="reviews"><h2>Ratings and reviews</h2><div class="rsum"><div class="rbig"><b>'+p.r+'</b>'+stars(p.r)+'<span>'+fmt(rv.n)+' ratings</span></div><div class="rbars">'+[5,4,3,2,1].map(function(s,k){var pc=Math.round(rv.share[k]*100);return '<div class="rbar"><span>'+s+' &#9733;</span><div class="rtrack"><div class="rfill" style="width:'+pc+'%"></div></div><span>'+pc+'%</span></div>'}).join('')+'</div></div>';
    h+=rv.list.map(function(r){return '<div class="rv"><div class="who">'+stars(r.stars)+'<b>'+r.name+'</b><span>'+r.city+'</span><span>'+r.when+'</span><span class="vp">Verified purchase</span></div><p>'+r.txt+'</p></div>'}).join('')+'</section>';
    var rel=P.filter(function(q){return q!==p&&q.c===p.c}).sort(function(a,b){return (b.i===p.i)-(a.i===p.i)}).slice(0,4);
    if(rel.length)h+='<section class="psec"><h2>You may also like</h2><div class="grid">'+rel.map(card).join('')+'</div></section>';
    h+='<div class="pbar"><div class="pp"><small>Total</small><b>Rs. '+fmt(p.p*pd.q)+'</b></div><button class="btn-add" type="button" data-pdp-add'+dis+'>Add to cart</button><button class="btn-buy" type="button" data-pdp-buy'+dis+'>Buy now</button></div>';
    $('#productView').innerHTML=h+'</div>';
  }
  function renderNotFound(slug){
    var safe=String(slug).replace(/[^a-z0-9_.~-]/gi,'').slice(0,60);
    var sug=P.slice().sort(function(a,b){return b.s-a.s}).slice(0,4);
    $('#productView').innerHTML='<div class="wrap pdp"><div class="nf"><div class="big">404</div><h1>Product not found</h1><p>We could not find a product for <code>'+safe+'</code>. It may have been removed, or the link may be mistyped.</p><button class="btn solid" type="button" data-go-home>Back to products</button></div><section class="psec"><h2>Popular right now</h2><div class="grid">'+sug.map(card).join('')+'</div></section></div>';
  }
  function showProduct(slug){
    var p=bySlug(slug);
    if(p&&pd&&pd.p===p&&!$('#productView').hidden)return;
    $('#home').hidden=true;$('#ordersView').hidden=true;$('#adminView').hidden=true;$('#categoryView').hidden=true;$('#accountView').hidden=true;$('#cartView').hidden=true;$('#drawerScrim').hidden=true;$('#authScrim').hidden=true;$('#authPageView').hidden=true;$('#productView').hidden=false;
    if(!p){pd=null;renderNotFound(slug);document.title='Product not found | Chowk';toTop();return}
    var pcf=vcfg(p);pd={p:p,slug:slug,s:'',c:pdColor(p,pcf),q:1,slide:0,err:''};
    renderPdp();document.title=p.n.split(',')[0]+' | Chowk';toTop();
  }
  function openProduct(slug){
    showProduct(slug);
    try{location.hash='product-'+slug}catch(x){}
  }
  function route(){
    var h=location.hash||'';
    if(h==='#forgot-password'){showAuthPage('forgot');return}
    if(h.indexOf('#reset-password')===0){showAuthPage('reset',h.slice(16));return}
    if(h==='#orders'||h.indexOf('#order-')===0){showTrack(h);return}
    if(h==='#seller'){showSeller();return}
    if(h==='#account'||h.indexOf('#account/')===0){showAccount(h.slice(9));return}
    if(h.indexOf('#category-')===0){showCategory(h.slice(10));return}
    if(h.indexOf('#product-')===0)showProduct(h.slice(9));
    else if(!$('#productView').hidden||!$('#ordersView').hidden||!$('#adminView').hidden||!$('#categoryView').hidden||!$('#accountView').hidden||!$('#authPageView').hidden)showHome();
  }
  function backToShop(){
    showHome();
    try{if((location.hash||'').indexOf('#product-')===0)location.hash='products'}catch(x){}
    var el=$('#products');if(el&&el.scrollIntoView)el.scrollIntoView();
  }
  $('#productView').addEventListener('click',function(e){
    var t=e.target.closest('button');if(!t)return;
    if(t.hasAttribute('data-go-home')){backToShop();return}
    if(!pd)return;
    var i=P.indexOf(pd.p),name=pd.p.n.split(',')[0];
    if(t.dataset.slide!==undefined){pd.slide=+t.dataset.slide;renderPdp();return}
    if(t.dataset.gstep!==undefined){pd.slide=(pd.slide+(+t.dataset.gstep)+4)%4;renderPdp();return}
    if(t.dataset.os!==undefined){pd.s=t.dataset.os;pd.err=pd.err.replace('s','');renderPdp();return}
    if(t.dataset.oc!==undefined){pd.c=t.dataset.oc;pd.err=pd.err.replace('c','');renderPdp();return}
    if(t.dataset.qd!==undefined){var cap=pdCap();pd.q=Math.max(1,Math.min(cap,pd.q+(+t.dataset.qd)));renderPdp();return}
    if(t.hasAttribute('data-pdp-add')){if(pdValidate()&&addToCart(name,{s:pd.s,c:pd.c},pd.q))renderPdp();return}
    if(t.hasAttribute('data-pdp-buy')){if(pdValidate()&&addToCart(name,{s:pd.s,c:pd.c},pd.q,true)){showCart();toast('Review your order, then proceed to checkout.')}return}
    if(t.dataset.jump){var el=document.getElementById(t.dataset.jump);if(el&&el.scrollIntoView)el.scrollIntoView({behavior:'smooth'});return}
  });
  var tx=null;
  $('#productView').addEventListener('touchstart',function(e){tx=e.target.closest('.stage')?e.touches[0].clientX:null},{passive:true});
  $('#productView').addEventListener('touchend',function(e){
    if(tx===null||!pd)return;var dx=e.changedTouches[0].clientX-tx;tx=null;
    if(Math.abs(dx)>45){pd.slide=(pd.slide+(dx<0?1:-1)+4)%4;renderPdp()}
  },{passive:true});
  document.addEventListener('click',function(e){
    var l=e.target.closest('a[href^="#product-"]');
    if(l){e.preventDefault();openProduct(l.getAttribute('href').slice(9));return}
    var c=e.target.closest('.card,.rk');
    if(c&&!e.target.closest('button,select,input,a')){var a2=c.querySelector('a[href^="#product-"]');if(a2)openProduct(a2.getAttribute('href').slice(9))}
  });

  function sanitize(){
    var fixList=function(a){var out=[];a.forEach(function(i){var f=vnorm(i);if(!f)return;var j=find(out,f.n,f.o);if(j>-1)out[j].q=Math.min(10,vstock(prod(f.n),f.s,f.c),out[j].q+f.q);else out.push(f)});return out};
    cart=fixList(cart);saved=fixList(saved);
    if(typeof coupon!=='string')coupon=null;
    persist();
  }
  sanitize();
  $('#cartView').addEventListener('error',function(e){
    var im=e.target;if(!im||im.tagName!=='IMG')return;
    im.outerHTML='<svg class="ico" aria-hidden="true"><use href="#i-'+(im.getAttribute('data-ic')||'bag')+'"/></svg>';
  },true);
  badge();
  document.addEventListener('click',function(e){
    var a=e.target.closest('.add');
    if(a){addToCart(a.dataset.n);return}
    var c=e.target.closest('[data-copy]');
    if(c){var v=c.dataset.copy;var done=function(){toast('Code '+v+' copied')};
      try{navigator.clipboard.writeText(v).then(done,function(){toast('Select and copy: '+v)})}catch(x){toast('Select and copy: '+v)}return}
    var cat=e.target.closest('[data-cat]');
    if(cat){$('#drawerScrim').hidden=true;
      var name=cat.dataset.cat,map={'Electronics':'Electronics','Mobiles and tablets':'Electronics','Audio and wearables':'Electronics','Laptops and PCs':'Electronics',"Women's fashion":'Fashion',"Men's fashion":'Fashion','Bags and wallets':'Fashion','Footwear':'Fashion','Watches':'Electronics','Home and living':'Home','Lighting and decor':'Home','Beauty and health':'Beauty'};
      cur=map[name]||'All';renderChips();renderProd();return}
    if(e.target.closest('[data-filter-jump]')){document.getElementById('products').scrollIntoView({behavior:'smooth'})}
  });
  $('#cartBtn').addEventListener('click',showCart);

  /* search */
  $('#searchForm').addEventListener('submit',function(e){
    e.preventDefault();showHome();var q=$('#q').value.trim().toLowerCase();if(!q)return;
    var hits=P.filter(function(p){return p.n.toLowerCase().indexOf(q)>-1||p.c.toLowerCase().indexOf(q)>-1});
    $('#prodGrid').innerHTML=hits.length?hits.map(card).join(''):'<p style="grid-column:1/-1;color:var(--muted)">No products match "'+q.replace(/[<>&"]/g,'')+'". Try a shorter word.</p>';
    cur='All';renderChips();document.getElementById('products').scrollIntoView({behavior:'smooth'});
  });

  /* drawer */
  $('#catOpen').addEventListener('click',function(){$('#drawerScrim').hidden=false});
  $('#catClose').addEventListener('click',function(){$('#drawerScrim').hidden=true});
  $('#drawerFill').addEventListener('click',function(){$('#drawerScrim').hidden=true});

  /* auth modal */
  var mode='login',loginNotice='';
  function setMode(m){mode=m;$('#tabLogin').setAttribute('aria-selected',m==='login');$('#tabSignup').setAttribute('aria-selected',m==='signup');$('#nameWrap').hidden=m==='login';$('#authSubmit').textContent=m==='login'?'Login':'Create account';authExtras()}
  document.querySelectorAll('[data-auth]').forEach(function(b){b.addEventListener('click',function(){setMode(b.dataset.auth);$('#authScrim').hidden=false})});
  document.querySelectorAll('[data-tab]').forEach(function(b){b.addEventListener('click',function(){setMode(b.dataset.tab)})});
  $('#authClose').addEventListener('click',function(){loginNotice='';$('#authScrim').hidden=true});
  $('#authScrim').addEventListener('click',function(e){if(e.target===this)this.hidden=true});
  $('#authForm').addEventListener('submit',function(e){e.preventDefault();handleAuth()});
  document.addEventListener('keydown',function(e){if(e.key==='Escape'){$('#authScrim').hidden=true;$('#drawerScrim').hidden=true}});
  /* ===== Order tracking: frontend demo, localStorage only, no backend ===== */
  var OKEY='chowk-orders-v1',HR=3600000,DAY=86400000;
  var STEPS=[['placed','Order placed','Your order has been placed.'],['confirmed','Order confirmed','Your order has been confirmed.'],['processing','Processing','The seller is preparing your order.'],['qc','Quality check','Your product passed its quality check.'],['packed','Packed','Your product has been packed successfully.'],['shipped','Shipped / dispatched','Your order has been handed to the courier.'],['transit','In transit','Your package is currently in transit.'],['dc','Reached local distribution center','Your package reached the distribution center in your city.'],['ofd','Out for delivery','Your product is out for delivery.'],['delivered','Delivered','Your order has been delivered successfully.']];
  var SKIP={standard:[],express:['qc','dc']},TYPES={standard:'Standard delivery',express:'Express delivery (skips quality check and local center)'};
  var DEMO={name:'Ayesha Khan',phone:'0300 1234567',addr:'House 14, Street 7, Block B, Gulshan-e-Iqbal',city:'Karachi'};
  var CK='<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';
  var orders=[],adm={sel:null,q:'',f:'all'},closeAsk=null;
  function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
  function p2(n){return n<10?'0'+n:''+n}
  function ymd(t){var d=new Date(t);return d.getFullYear()+'-'+p2(d.getMonth()+1)+'-'+p2(d.getDate())}
  function lcl(t){var d=new Date(t);return ymd(t)+'T'+p2(d.getHours())+':'+p2(d.getMinutes())}
  function fdt(t){return new Date(t).toLocaleString('en-PK',{day:'numeric',month:'short',year:'numeric',hour:'numeric',minute:'2-digit'})}
  function fd(s){var d=new Date(s+'T12:00:00');return(!s||isNaN(d))?'Not available yet':d.toLocaleDateString('en-PK',{weekday:'short',day:'numeric',month:'short',year:'numeric'})}
  function lbl(k){for(var i=0;i<STEPS.length;i++)if(STEPS[i][0]===k)return STEPS[i][1];return k}
  function stepsFor(o){var sk=SKIP[o.type]||[];return STEPS.filter(function(s){return sk.indexOf(s[0])<0})}
  function curStep(o){var a=stepsFor(o);for(var i=0;i<a.length;i++)if(!o.done[a[i][0]])return a[i];return null}
  function lastDone(o){var r=null;stepsFor(o).forEach(function(s){if(o.done[s[0]])r=s});return r}
  function pct(o){var a=stepsFor(o);return Math.round(a.filter(function(s){return o.done[s[0]]}).length/a.length*100)}
  function byId(id){for(var i=0;i<orders.length;i++)if(orders[i].id===id)return orders[i]}
  function findQ(q){q=String(q||'').trim().toLowerCase();for(var i=0;i<orders.length;i++){var o=orders[i];if(o.id.toLowerCase()===q||o.trk.toLowerCase()===q||(o.trackingNo&&o.trackingNo.toLowerCase()===q))return o}}
  function addHist(o,kind,text,ts){o.hist.push({ts:ts||Date.now(),kind:kind,text:text})}
  function mk(n,cust,city,addr,items,type,ago,keys,x){
    var now=Date.now(),pl=now-ago*HR,gap=ago*HR*.9/Math.max(keys.length,1);
    var o={id:'CHK-'+n,trk:'TRK-'+(n*7919+11182275).toString(16).toUpperCase().slice(-6),cust:cust,phone:'03'+(10+n%80)+' '+('000000'+n*3571).slice(-7),addr:addr,city:city,items:items,type:type,placed:pl,eta:ymd(pl+5*DAY),courier:'',trackingNo:'',notes:'',done:{},delays:[],failed:[],hist:[]};
    keys.forEach(function(k,i){var t=pl+Math.round(i*gap);o.done[k]=t;addHist(o,'step','Completed: '+lbl(k),t)});
    for(var k in x)o[k]=x[k];return o}
  function seedOrders(){
    var N=Date.now(),a=[
      mk(1042,'Ayesha Khan','Karachi','House 14, Street 7, Block B, Gulshan-e-Iqbal',[{n:'Wireless Earbuds Pro',o:'Black',q:1},{n:'Cotton Kurta',o:'M',q:2}],'standard',20,['placed','confirmed','processing'],{}),
      mk(1041,'Bilal Ahmed','Lahore','Flat 3, Gulberg III, Main Boulevard',[{n:'Smart Watch Active 2',o:'',q:1}],'express',60,['placed','confirmed','processing','packed','shipped','transit'],{courier:'TCS',trackingNo:'TCS-7789120451',eta:ymd(N+2*DAY)}),
      mk(1040,'Sana Malik','Islamabad','Street 21, F-10/3',[{n:'Bedside Table Lamp',o:'Warm white',q:1}],'standard',110,['placed','confirmed','processing','qc','packed','shipped','transit','dc','ofd'],{courier:'Leopards Courier',trackingNo:'LEO-5520093187',eta:ymd(N-DAY)}),
      mk(1039,'Usman Raza','Karachi','B-22, North Nazimabad Block H',[{n:'Android Phone 8GB/256GB',o:'',q:1}],'standard',200,STEPS.map(function(s){return s[0]}),{courier:'TCS',trackingNo:'TCS-6641870023',eta:ymd(N-3*DAY)}),
      mk(1038,'Hina Farooq','Faisalabad','Chenab Colony, Street 4',[{n:'Cotton Kurta',o:'L',q:1}],'standard',90,['placed','confirmed','processing','qc','packed','shipped','transit','dc'],{courier:'PostEx',trackingNo:'PEX-3309817726',eta:ymd(N+3*DAY)})];
    a[2].failed.push({ts:N-6*HR,note:'Customer was not available at the address.'});addHist(a[2],'failed','Delivery attempt failed: Customer was not available at the address.',N-6*HR);
    a[4].delays.push({ts:N-10*HR,note:'Weather delay at the sorting hub.',eta:a[4].eta});addHist(a[4],'delay','Delay recorded: Weather delay at the sorting hub.',N-10*HR);
    return a}
  function loadOrders(){var r=null;try{r=JSON.parse(localStorage.getItem(OKEY))}catch(x){}
    if(Array.isArray(r)&&r.length){orders=r.filter(function(o){return o&&o.id&&Array.isArray(o.items)&&o.done&&typeof o.done==='object'}).map(function(o){o.hist=o.hist||[];o.delays=o.delays||[];o.failed=o.failed||[];o.trk=o.trk||'';o.type=SKIP[o.type]?o.type:'standard';return o})}
    if(!orders.length){orders=seedOrders();saveOrders()}}
  function saveOrders(){try{localStorage.setItem(OKEY,JSON.stringify(orders))}catch(x){}}
  loadOrders();

  function thumb(it){var p=prod(it.n);if(!p)return'<span class="ci-img"></span>';return'<span class="ci-img" style="--h:'+p.h+'">'+((p.imgs&&p.imgs[0])?'<img src="'+p.imgs[0]+'" alt="" loading="lazy" data-ic="'+p.i+'">':ic(p.i))+'</span>'}
  function names(o){var n=o.items.map(function(i){return esc(i.n)});return n[0]+(n.length>1?' +'+(n.length-1)+' more':'')}
  function status(o){var l=lastDone(o);return l?l[1]:'Not started'}
  function chip(o){var warn=!o.done.delivered&&o.failed.length&&(!lastDone(o)||o.failed[o.failed.length-1].ts>o.done[lastDone(o)[0]]);return'<span class="stc'+(warn?' warn':'')+'">'+(warn?'Delivery attempt failed':esc(status(o)))+'</span>'}
  function progress(o){var v=pct(o);return'<div class="oprog" role="progressbar" aria-label="Delivery progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="'+v+'"><i style="width:'+v+'%"></i></div>'}
  function etaOf(o){return o.done.delivered?'Delivered '+fdt(o.done.delivered):'Estimated '+fd(o.eta)}
  var DEMONOTE='<details class="demo"><summary>Demo mode: tracking updates are simulated</summary><p>Everything here is stored in this browser only and is not connected to a courier or a server. These need a backend or external service in production:</p><ul><li>Live courier scans, locations and maps</li><li>Secure access so customers only see their own orders</li><li>Seller login and permissions</li><li>Syncing across devices, and email or SMS alerts</li></ul></details>';
  function timeline(o,admin){
    var c=curStep(o),ld=lastDone(o);
    return'<ol class="otl" aria-label="Delivery timeline">'+stepsFor(o).map(function(s){
      var d=o.done[s[0]],cls=d?'done':(c&&c[0]===s[0]?'now':'todo'),act='';
      if(admin&&c&&c[0]===s[0])act='<button class="btn solid" type="button" data-done="'+esc(o.id)+'">Mark complete</button>';
      if(admin&&d&&ld&&ld[0]===s[0]&&s[0]!=='placed')act='<button class="btn" type="button" data-undo="'+esc(o.id)+'">Undo</button>';
      return'<li class="'+cls+'"'+(cls==='now'?' aria-current="step"':'')+'><span class="dot">'+(d?CK:'')+'</span><div class="row"><div><b>'+s[1]+'</b><small>'+(d?fdt(d):cls==='now'?'In progress':'Pending')+'</small><span class="sr">'+(d?'Completed':cls==='now'?'Current step':'Pending')+'</span></div>'+act+'</div></li>'}).join('')+'</ol>'}
  function histHtml(o){var h=o.hist.slice().sort(function(a,b){return a.ts-b.ts});
    return h.length?'<ul class="hist">'+h.map(function(e){return'<li>'+esc(e.text)+'<small>'+fdt(e.ts)+'</small></li>'}).join('')+'</ul>':'<p class="muted">No history yet.</p>'}
  function banners(o){var h='';
    if(o.done.delivered)return'';
    if(o.failed.length){var f=o.failed[o.failed.length-1];h+='<div class="alert" role="status"><b>Delivery attempt failed</b> on '+fdt(f.ts)+': '+esc(f.note)+' Contact support below to arrange another attempt.</div>'}
    if(o.delays.length){var d=o.delays[o.delays.length-1];h+='<div class="alert" role="status"><b>Delivery delayed</b> ('+fdt(d.ts)+'): '+esc(d.note)+'</div>'}
    return h}
  function courierBox(o){return'<dl class="kv"><dt>Courier</dt><dd>'+(esc(o.courier)||'Not assigned yet')+'</dd><dt>Tracking number</dt><dd>'+(esc(o.trackingNo)||'Not available yet')+'</dd><dt>Delivery</dt><dd>'+etaOf(o)+'</dd><dt>Status</dt><dd>'+esc(status(o))+'</dd></dl>'+(o.notes?'<p class="muted" style="margin-top:8px">Seller note: '+esc(o.notes)+'</p>':'')+'<p class="muted" style="margin-top:8px;font-size:13px">Live courier tracking is not connected in this demo, so no map or courier scan events are shown.</p>'}

  /* customer views */
  function listHtml(){
    return'<div class="wrap trk"><div class="thead"><h1>My orders</h1><div class="tbox"><a class="btn" href="#seller">Seller dashboard (demo)</a><button class="btn" type="button" data-go-home>Keep shopping</button></div></div>'+DEMONOTE+
    '<form class="find" id="findForm" role="search"><input id="findQ" type="search" placeholder="Enter an Order ID or Tracking ID" aria-label="Order ID or Tracking ID"><button class="btn solid" type="submit">Track</button></form><p class="ferr" id="findErr" role="alert"></p>'+
    (orders.length?'<ul class="olist">'+orders.slice().sort(function(a,b){return b.placed-a.placed}).map(function(o){return'<li><a class="ocard" href="#order-'+esc(o.id)+'">'+thumb(o.items[0])+'<div><h3>'+names(o)+'</h3><p class="meta">'+esc(o.id)+' · Placed '+fd(ymd(o.placed))+'</p></div><div class="foot">'+chip(o)+progress(o)+'<span class="meta">'+pct(o)+'% complete · '+etaOf(o)+'</span><b style="color:var(--brand)">Track my order</b></div></a></li>'}).join('')+'</ul>':'<div class="empty"><span class="eico">'+ic('cart')+'</span><h2>No orders yet</h2><p>When you place an order it will show up here with its delivery progress.</p><button class="btn solid" type="button" data-go-home>Start shopping</button></div>')+'</div>'}
  function detailHtml(o){
    var ld=lastDone(o),msg=ld?ld[2]:'We have not received this order yet.';
    return'<div class="wrap trk"><div class="thead"><div><a class="back" href="#orders">&larr; All orders</a><h1>Track order '+esc(o.id)+'</h1><p class="muted">Tracking ID '+esc(o.trk)+'</p></div>'+chip(o)+'</div>'+DEMONOTE+
    '<div class="odet"><div class="stack"><section class="card2" aria-labelledby="o1"><h2 id="o1">Order details</h2>'+o.items.map(function(i){return'<div class="item">'+thumb(i)+'<div><b>'+esc(i.n)+'</b><div class="muted">'+(i.o?esc(i.o)+' · ':'')+'Quantity '+(+i.q||1)+'</div></div></div>'}).join('')+
    '<dl class="kv" style="margin-top:8px"><dt>Order date</dt><dd>'+fdt(o.placed)+'</dd><dt>Delivery type</dt><dd>'+esc(TYPES[o.type])+'</dd><dt>Deliver to</dt><dd>'+(esc(o.cust)||'Not available')+'<br>'+(esc(o.addr)||'Address not available')+(o.city?', '+esc(o.city):'')+'</dd><dt>Estimated delivery</dt><dd>'+(o.done.delivered?'Delivered':fd(o.eta))+'</dd></dl></section>'+
    '<section class="card2" aria-labelledby="o2"><h2 id="o2">Courier details</h2>'+courierBox(o)+'</section>'+
    '<section class="card2" aria-labelledby="o3"><h2 id="o3">Delayed or a problem?</h2><form class="of" data-support="'+esc(o.id)+'"><label>Tell us what went wrong<textarea id="supTxt" maxlength="300" placeholder="For example: my package is late or I missed the delivery"></textarea></label><p class="ferr" role="alert"></p><button class="btn solid" type="submit">Contact support</button><p class="muted" style="font-size:13px">Demo only: your message is saved to this order\'s history in this browser and is not sent to anyone.</p></form></section></div>'+
    '<div class="stack"><section class="card2" aria-labelledby="o4"><h2 id="o4">Delivery journey</h2>'+banners(o)+progress(o)+'<p class="muted" style="margin-top:6px"><b>'+pct(o)+'%</b> complete</p><div class="msg" role="status">'+CK.replace('class="ico"','class="ico" style="width:20px;height:20px;flex:none;color:var(--brand)"')+'<span>'+esc(msg)+'</span></div>'+timeline(o,false)+'</section>'+
    '<section class="card2" aria-labelledby="o5"><h2 id="o5">Status history</h2>'+histHtml(o)+'</section></div></div></div>'}
  function notFound(id){return'<div class="wrap trk"><div class="nf"><h1>Order not found</h1><p>We could not find an order for <code>'+esc(id)+'</code>. Check the Order ID or Tracking ID, or go back to your orders.</p><a class="btn solid" href="#orders">My orders</a></div></div>'}
  function goTo(h){if(location.hash===h){route();return}try{location.hash=h}catch(x){}if(location.hash!==h)route()}
  document.addEventListener('click',function(e){var a=e.target.closest('a[href="#orders"],a[href="#seller"],a[href^="#order-"]');if(!a||e.defaultPrevented||e.button||e.metaKey||e.ctrlKey||e.shiftKey)return;e.preventDefault();goTo(a.getAttribute('href'))});
  function errView(v,h){v.innerHTML='<div class="wrap trk"><div class="nf" role="alert"><h1>Could not load your orders</h1><p>Something went wrong while reading order data in this browser. Your saved orders have not been changed.</p><button class="btn solid" type="button" data-retry="'+esc(h)+'">Try again</button> <button class="btn" type="button" data-resetfix>Reset demo data</button></div></div>'}
  function hideAll(){['#home','#cartView','#productView','#ordersView','#adminView','#categoryView','#accountView','#authPageView','#drawerScrim','#authScrim'].forEach(function(s){$(s).hidden=true})}
  function showTrack(h){
    hideAll();var v=$('#ordersView');v.hidden=false;toTop();loadOrders();
    try{showTrack2(h,v)}catch(x){errView(v,h)}}
  function showTrack2(h,v){
    var quick=matchMedia('(prefers-reduced-motion: reduce)').matches;
    if(h==='#orders'){document.title='My orders | Chowk';if(quick){v.innerHTML=listHtml();return}v.innerHTML='<div class="wrap trk" aria-busy="true" role="status"><span class="sr">Loading your orders</span><div class="skel" style="height:56px"></div><div class="skel" style="margin-top:12px;height:180px"></div></div>';setTimeout(function(){if(location.hash==='#orders'&&!v.hidden){try{v.innerHTML=listHtml()}catch(x){errView(v,h)}}},250);return}
    var id=decodeURIComponent(h.slice(7)),o=byId(id);document.title='Track order | Chowk';
    if(!o){v.innerHTML=notFound(id);return}
    if(quick){v.innerHTML=detailHtml(o);return}
    v.innerHTML='<div class="wrap trk" aria-busy="true" role="status"><span class="sr">Loading order status</span><div class="skel"></div><div class="skel" style="margin-top:12px;height:260px"></div></div>';
    setTimeout(function(){if(location.hash==='#order-'+id&&!v.hidden){try{loadOrders();var o2=byId(id);v.innerHTML=o2?detailHtml(o2):notFound(id)}catch(x){errView(v,h)}}},300)}
  $('#ordersView').addEventListener('submit',function(e){
    e.preventDefault();var f=e.target;
    if(f.id==='findForm'){var q=$('#findQ').value.trim(),er=$('#findErr');if(!q){er.textContent='Enter an Order ID or Tracking ID.';return}var o=findQ(q);if(!o){er.textContent='No order found for "'+q+'". Check the ID and try again.';return}goTo('#order-'+o.id);return}
    if(f.hasAttribute('data-support')){var o2=byId(f.dataset.support),t=$('#supTxt').value.trim(),er2=f.querySelector('.ferr');if(!o2)return;if(t.length<10){er2.textContent='Describe the problem in at least 10 characters.';return}addHist(o2,'support','You contacted support: '+t);saveOrders();$('#ordersView').innerHTML=detailHtml(o2);toast('Saved in this demo. Nothing was sent to the seller.')}});
  $('#ordersView').addEventListener('click',function(e){
    if(e.target.closest('[data-go-home]')){try{location.hash='top'}catch(x){}showHome();return}
    var r=e.target.closest('[data-retry]');if(r){showTrack(r.dataset.retry);return}
    if(e.target.closest('[data-resetfix]')){try{localStorage.removeItem(OKEY)}catch(x){}orders=[];loadOrders();showTrack('#orders')}});

  /* confirmation dialog */
  function ask(o){
    var sc=$('#oConfirm'),prev=document.activeElement;
    sc.innerHTML='<div class="modal" role="alertdialog" aria-modal="true" aria-labelledby="cT"><h2 id="cT">'+esc(o.title)+'</h2><div class="cbody">'+o.body+'</div><p class="ferr" role="alert" id="cErr"></p><div class="crow"><button class="btn" type="button" data-cx>Cancel</button><button class="btn solid" type="button" data-ok>'+esc(o.ok)+'</button></div></div>';
    sc.hidden=false;var first=sc.querySelector('input')||sc.querySelector('[data-ok]');first.focus();
    function close(){sc.hidden=true;sc.innerHTML='';closeAsk=null;if(prev&&prev.focus&&document.contains(prev))prev.focus()}
    closeAsk=close;
    sc.onclick=function(e){if(e.target===sc||e.target.hasAttribute('data-cx'))close();else if(e.target.hasAttribute('data-ok')){var er=o.run&&o.run(sc);if(er){$('#cErr').textContent=er;return}close()}}}
  document.addEventListener('keydown',function(e){
    if(!closeAsk)return;
    if(e.key==='Escape'){closeAsk();return}
    if(e.key==='Tab'){var f=$('#oConfirm').querySelectorAll('input,button'),a=f[0],z=f[f.length-1];if(e.shiftKey&&document.activeElement===a){e.preventDefault();z.focus()}else if(!e.shiftKey&&document.activeElement===z){e.preventDefault();a.focus()}}});

  /* seller dashboard */
  function showSeller(){hideAll();loadOrders();$('#adminView').hidden=false;document.title='Seller dashboard (demo) | Chowk';toTop();
    $('#adminView').innerHTML='<div class="wrap trk"><div class="thead"><div><h1>Seller dashboard</h1><p class="muted">Frontend demonstration: no login, no server</p></div><div class="tbox"><a class="btn" href="#orders">Customer view</a><button class="btn" type="button" data-reset>Reset demo data</button></div></div>'+DEMONOTE+
    '<div class="adm"><section class="card2" aria-label="Orders"><div class="of"><label>Search<input id="admQ" type="search" placeholder="Order ID, tracking ID or customer"></label><label>Status<select id="admF"><option value="all">All statuses</option>'+STEPS.map(function(s){return'<option value="'+s[0]+'">'+s[1]+'</option>'}).join('')+'</select></label></div><ul class="al" id="admList"></ul></section><section id="admPanel" aria-live="polite"></section></div></div>';
    $('#admQ').value=adm.q;$('#admF').value=adm.f;admList();admPanel()}
  function admList(){
    var q=adm.q.trim().toLowerCase(),r=orders.filter(function(o){var l=lastDone(o);return(adm.f==='all'||(l&&l[0]===adm.f))&&(!q||[o.id,o.trk,o.trackingNo,o.cust].join(' ').toLowerCase().indexOf(q)>-1)});
    $('#admList').innerHTML=r.length?r.map(function(o){return'<li><button class="arow" type="button" data-sel="'+esc(o.id)+'" aria-pressed="'+(adm.sel===o.id)+'"><span><b>'+esc(o.id)+'</b>'+chip(o)+'</span><span>'+esc(o.cust)+' · '+esc(o.trk)+'</span></button></li>'}).join(''):'<li class="muted">No orders match. Clear the search or choose "All statuses".</li>'}
  function admPanel(){
    var o=byId(adm.sel),el=$('#admPanel');
    if(!o){el.innerHTML='<div class="empty"><span class="eico">'+ic('cart')+'</span><h2>Select an order</h2><p>Pick an order from the list to update its delivery status.</p></div>';return}
    var c=curStep(o),ld=lastDone(o),canFail=o.done.ofd&&!o.done.delivered,fin=!!o.done.delivered;
    el.innerHTML='<div class="stack"><section class="card2"><div class="thead"><div><h2 style="margin:0">'+esc(o.id)+'</h2><p class="muted">'+esc(o.trk)+' · '+esc(o.cust)+', '+esc(o.city)+'</p></div>'+chip(o)+'</div>'+progress(o)+'<p class="muted" style="margin-top:6px"><b>'+pct(o)+'%</b> complete'+(c?' · Next: '+c[1]:' · All steps done')+'</p>'+timeline(o,true)+'</section>'+
    '<section class="card2"><h2>Courier and delivery details</h2><form class="of" data-form="info" novalidate><div class="split"><label>Courier company<input name="courier" list="cl" maxlength="40" value="'+esc(o.courier)+'"><datalist id="cl"><option value="TCS"><option value="Leopards Courier"><option value="M&amp;P"><option value="PostEx"><option value="BlueEx"><option value="Trax"></datalist></label><label>Tracking number<input name="trk" maxlength="24" value="'+esc(o.trackingNo)+'" placeholder="Letters, numbers, dashes"></label></div><label>Estimated delivery date<input type="date" name="eta" value="'+esc(o.eta)+'"'+(fin?' disabled':'')+'></label><label>Notes (optional)<textarea name="notes" maxlength="300">'+esc(o.notes)+'</textarea></label><p class="ferr" role="alert"></p><button class="btn solid" type="submit">Save details</button></form></section>'+
    '<section class="card2"><h2>Delays and failed attempts</h2><div class="split"><form class="of" data-form="delay" novalidate><label>Reason for delay<input name="note" maxlength="120"'+(fin?' disabled':'')+'></label><label>New estimated date<input type="date" name="eta"'+(fin?' disabled':'')+'></label><p class="ferr" role="alert"></p><button class="btn" type="submit"'+(fin?' disabled':'')+'>Record delay</button></form><form class="of" data-form="fail" novalidate><label>What happened<input name="note" maxlength="120"'+(canFail?'':' disabled')+'></label><p class="ferr" role="alert"></p><button class="btn" type="submit"'+(canFail?'':' disabled')+'>Record failed attempt</button>'+(canFail?'':'<p class="muted" style="font-size:13px">Available once the order is out for delivery.</p>')+'</form></div></section>'+
    '<section class="card2"><h2>Status history</h2>'+histHtml(o)+'</section></div>'}
  function afterAdm(msg){saveOrders();admList();admPanel();toast(msg)}
  function completeDlg(o){
    var c=curStep(o);if(!c)return;
    ask({title:'Mark "'+c[1]+'" complete?',ok:'Mark complete',body:'<p>This updates what the customer sees for '+esc(o.id)+'.</p><label>Completed at<input type="datetime-local" id="cAt" value="'+lcl(Date.now())+'"></label>',run:function(){
      var ts=new Date($('#cAt').value).getTime(),ld=lastDone(o),min=ld?o.done[ld[0]]:o.placed;
      if(isNaN(ts))return'Enter the date and time this step was completed.';
      if(ts<min)return'This cannot be earlier than the previous step ('+fdt(min)+').';
      if(ts>Date.now()+60000)return'This cannot be in the future.';
      if(c[0]==='shipped'&&(!o.courier||!o.trackingNo))return'Save the courier and tracking number before marking this order as shipped.';
      o.done[c[0]]=ts;addHist(o,'step','Completed: '+c[1],ts);afterAdm(c[1]+' marked complete.')}})}
  function undoDlg(o){var l=lastDone(o);if(!l)return;
    ask({title:'Undo "'+l[1]+'"?',ok:'Undo step',body:'<p>This sets the step back to pending. The change is recorded in the status history.</p>',run:function(){delete o.done[l[0]];addHist(o,'revert','Reverted: '+l[1]+' set back to pending');afterAdm(l[1]+' set back to pending.')}})}
  $('#adminView').addEventListener('input',function(e){if(e.target.id==='admQ'){adm.q=e.target.value;admList()}});
  $('#adminView').addEventListener('change',function(e){if(e.target.id==='admF'){adm.f=e.target.value;admList()}});
  $('#adminView').addEventListener('click',function(e){
    var t=e.target.closest('button');if(!t)return;
    if(t.dataset.sel){adm.sel=t.dataset.sel;admList();admPanel();if(matchMedia('(max-width:959px)').matches)$('#admPanel').scrollIntoView({behavior:'smooth'});return}
    if(t.dataset.done){var o=byId(t.dataset.done);if(o)completeDlg(o);return}
    if(t.dataset.undo){var o2=byId(t.dataset.undo);if(o2)undoDlg(o2);return}
    if(t.hasAttribute('data-reset'))ask({title:'Reset demo data?',ok:'Reset',body:'<p>This removes all demo orders and updates from this browser and restores the sample orders.</p>',run:function(){orders=seedOrders();adm.sel=null;saveOrders();admList();admPanel();toast('Demo data reset.')}})});
  $('#adminView').addEventListener('submit',function(e){
    e.preventDefault();var f=e.target,o=byId(adm.sel),k=f.dataset.form,er=f.querySelector('.ferr'),v=function(n){return f.elements[n].value.trim()};
    if(!o||!k)return;er.textContent='';
    if(k==='info'){
      var co=v('courier'),tn=v('trk'),eta=f.elements.eta.disabled?o.eta:v('eta'),nt=v('notes');
      if(tn&&!/^[A-Za-z0-9-]{6,24}$/.test(tn)){er.textContent='Tracking number must be 6 to 24 letters, numbers or dashes.';return}
      if(tn&&!co){er.textContent='Enter the courier company for this tracking number.';return}
      if(eta&&eta<ymd(o.placed)){er.textContent='Estimated delivery cannot be before the order date.';return}
      if(!eta&&!o.done.delivered){er.textContent='Choose an estimated delivery date.';return}
      ask({title:'Save delivery details?',ok:'Save details',body:'<p>Courier: <b>'+(esc(co)||'none')+'</b><br>Tracking number: <b>'+(esc(tn)||'none')+'</b><br>Estimated delivery: <b>'+fd(eta)+'</b></p>',run:function(){o.courier=co;o.trackingNo=tn;o.eta=eta;o.notes=nt;addHist(o,'info','Delivery details updated'+(co?' ('+co+(tn?', '+tn:'')+')':''));afterAdm('Delivery details saved.')}});return}
    if(k==='delay'){
      var n=v('note'),ne=v('eta');
      if(n.length<5){er.textContent='Enter a reason of at least 5 characters.';return}
      if(!ne){er.textContent='Choose the new estimated delivery date.';return}
      if(o.eta&&ne<=o.eta){er.textContent='The new date must be later than the current estimate ('+fd(o.eta)+').';return}
      ask({title:'Record this delay?',ok:'Record delay',body:'<p>'+esc(n)+'<br>New estimate: <b>'+fd(ne)+'</b></p>',run:function(){o.delays.push({ts:Date.now(),note:n,eta:ne});o.eta=ne;addHist(o,'delay','Delay recorded: '+n+' (new estimate '+fd(ne)+')');afterAdm('Delay recorded.')}});return}
    if(k==='fail'){
      var m=v('note');
      if(!o.done.ofd||o.done.delivered){er.textContent='A failed attempt can only be recorded while the order is out for delivery.';return}
      if(m.length<5){er.textContent='Enter what happened, at least 5 characters.';return}
      ask({title:'Record failed delivery attempt?',ok:'Record attempt',body:'<p>'+esc(m)+'</p>',run:function(){o.failed.push({ts:Date.now(),note:m});addHist(o,'failed','Delivery attempt failed: '+m);afterAdm('Failed attempt recorded.')}})}});

  function placeDemoOrder(){
    if(!cart.length)return;
    var n=orders.reduce(function(m,o){var k=+String(o.id).replace(/\D/g,'');return k>m?k:m},1000)+1,now=Date.now();
    var o={id:'CHK-'+n,trk:'TRK-'+Math.floor(Math.random()*16777215).toString(16).toUpperCase().padStart(6,'0'),cust:DEMO.name,phone:DEMO.phone,addr:locOrderAddr(),city:locOrderCity(),items:cart.map(function(i){return{n:i.n,s:i.s,c:i.c,o:i.o,q:i.q,id:i.id,pr:i.pr}}),type:'standard',placed:now,eta:ymd(now+etaDays()[1]*DAY),courier:'',trackingNo:'',notes:'',done:{placed:now},delays:[],failed:[],hist:[]};
    addHist(o,'step','Completed: Order placed',now);orders.unshift(o);saveOrders();
    cart=[];coupon=null;couponMsg=null;seeded=false;persist();badge();toast('Demo order '+o.id+' placed.');goTo('#order-'+o.id)}
  window.addEventListener('storage',function(e){if(e.key!==OKEY)return;loadOrders();if(!$('#ordersView').hidden)route();else if(!$('#adminView').hidden){admList();admPanel()}});

  /* ===== Category pages: Shop by Category -> subcategories -> products ===== */
  var SUBS={
    'Electronics':[['Mobile phones','phone',205,'smartphone|android phone'],['Laptops','laptop',225,'laptop'],['Headphones and earbuds','headphones',190,'headphones|earbuds'],['Smart watches and bands','watch',215,'smart watch|fitness band'],['Tablets','tablet',180,'tablet'],['Speakers','speaker',260,''],['Chargers and power banks','charger',45,''],['Keyboards and mice','keyboard',200,''],['Cameras','camera',330,'']],
    'Mobiles and tablets':[['Smartphones','phone',205,'smartphone|android phone'],['Tablets','tablet',180,'tablet'],['Chargers and cables','charger',45,''],['Cases and covers','bag',300,'']],
    'Audio and wearables':[['Headphones','headphones',260,'headphones'],['Earbuds','headphones',190,'earbuds'],['Smart watches','watch',215,'smart watch'],['Fitness bands','watch',170,'fitness band'],['Speakers','speaker',260,'']],
    "Women's fashion":[['Kurtas and suits','shirt',30,'kurta'],['Shawls and wraps','shirt',15,'shawl'],['Hoodies and sweatshirts','shirt',200,'hoodie'],['Handbags','bag',340,'handbag|shoulder bag'],['Dresses','dress',320,'']],
    "Men's fashion":[['Kurtas','shirt',30,'kurta'],['Hoodies and sweatshirts','shirt',200,'hoodie'],['Sneakers and shoes','shoe',210,'shoes|sneakers'],['Boots','shoe',25,'boots'],['Shirts','shirt',230,''],['Trousers','pants',220,'']],
    'Bags and wallets':[['Handbags','bag',340,'handbag'],['Shoulder bags','bag',320,'shoulder bag'],['Backpacks','bag',100,'backpack'],['Wallets','bag',25,'']],
    'Home and living':[['Table and desk lamps','lamp',45,'bedside table lamp|desk lamp'],['Floor lamps','lamp',60,'floor lamp'],['Kitchen and dining','cup',160,'']],
    'Beauty and health':[['Skincare','bottle',150,'serum|lotion'],['Hair care','bottle',120,'hair oil'],['Fragrances','bottle',330,''],['Makeup','bottle',350,'']],
    'Watches':[['Smart watches','watch',215,'smart watch'],['Fitness bands','watch',170,'fitness band'],['Analog watches','watch',45,'']],
    'Laptops and PCs':[['Everyday laptops','laptop',225,'slim laptop'],['Gaming laptops','laptop',350,'gaming laptop'],['Keyboards and mice','keyboard',200,''],['Monitors','laptop',180,'']],
    'Footwear':[['Running shoes','shoe',12,'running shoes'],['Sneakers','shoe',210,'sneakers'],['Boots','shoe',25,'boots'],['Sandals','shoe',45,'']],
    'Lighting and decor':[['Bedside lamps','lamp',45,'bedside'],['Desk lamps','lamp',20,'desk lamp'],['Floor lamps','lamp',60,'floor lamp']],
    'Grocery':[['Rice','bowl',45,''],['Flour and atta','sack',35,''],['Cooking oil','bottle',50,''],['Spices and masalas','jar',10,''],['Snacks','snack',25,''],['Tea and coffee','cup',20,''],['Dairy and eggs','carton',200,''],['Fruits and vegetables','fruit',110,'']],
    'Clothing':[['Shirts','shirt',230,''],['Trousers','pants',220,''],['Dresses','dress',320,''],['Kurtas','shirt',30,'kurta'],['Hoodies and sweatshirts','shirt',200,'hoodie'],['Shawls and wraps','shirt',15,'shawl'],['Shoes','shoe',12,'shoes|sneakers|boots']]
  };
  var cv=null;
  function catBy(slug){for(var k=0;k<CATS.length;k++)if(slugify(CATS[k][0])===slug)return CATS[k];return null}
  function subsOf(c){return(SUBS[c[0]]||[]).map(function(x){return{name:x[0],slug:slugify(x[0]),i:x[1],h:x[2],re:x[3]?new RegExp(x[3],'i'):null}})}
  function inSub(sb,p){return !!sb.re&&sb.re.test(p.n.split(',')[0])}
  function subItems(sb){return P.filter(function(p){return inSub(sb,p)})}
  function catItems(subs){return P.filter(function(p){return subs.some(function(sb){return inSub(sb,p)})})}
  function cHref(c,sl){return'#category-'+slugify(c[0])+(sl?'/'+sl:'')}
  function plural(n){return n+(n===1?' item':' items')}
  function subTile(c,sb){var n=subItems(sb).length;return'<a class="subt" href="'+cHref(c,sb.slug)+'"><span class="subi" style="--h:'+sb.h+'">'+ic(sb.i)+'</span><span class="subn">'+esc(sb.name)+'</span><span class="subc">'+(n?plural(n):'Coming soon')+'</span></a>'}
  function sortList(a,k){a=a.slice();
    if(k==='lo')a.sort(function(x,y){return x.p-y.p});
    else if(k==='hi')a.sort(function(x,y){return y.p-x.p});
    else if(k==='sold')a.sort(function(x,y){return y.s-x.s});
    else if(k==='rate')a.sort(function(x,y){return y.r-x.r});
    return a}
  function catEmpty(title,msg,btns){return'<div class="empty"><span class="eico">'+ic('cart')+'</span><h2>'+esc(title)+'</h2><p>'+esc(msg)+'</p><div class="row2">'+btns+'</div></div>'}
  function catNF(what){return'<div class="wrap catpage"><div class="nf"><div class="big">404</div><h1>Category not found</h1><p>We could not find <code>'+esc(String(what).slice(0,60))+'</code>. It may have been removed, or the link may be mistyped.</p><a class="btn solid" href="#top">Back to home</a></div></div>'}
  function renderCat(){
    var c=cv.c,subs=cv.subs,sub=cv.sub,all=catItems(subs),mode=cv.mode,list,h='';
    var last=mode==='sub'?sub.name:(mode==='all'?'All items':'');
    h+='<div class="wrap catpage"><nav class="crumbs" aria-label="Breadcrumb"><a class="lk" href="#top">Home</a><span>&rsaquo;</span>'+(last?'<a class="lk" href="'+cHref(c)+'">'+esc(c[0])+'</a><span>&rsaquo;</span><b>'+esc(last)+'</b>':'<b>'+esc(c[0])+'</b>')+'</nav>';
    var title=mode==='sub'?sub.name:c[0];
    var count=mode==='sub'?subItems(sub).length:all.length;
    var sub2=mode==='sub'?'in '+esc(c[0]):(mode==='all'?'':subs.length+' subcategories');
    h+='<header class="cathead"><span class="chico" style="--h:'+c[2]+'">'+ic(mode==='sub'?sub.i:c[1])+'</span><div><h1>'+esc(title)+(mode==='all'?' <span class="muted" style="font-size:.5em;font-weight:600">all items</span>':'')+'</h1><p>'+(count?plural(count):'No items yet')+(sub2?' &middot; '+sub2:'')+'</p></div>';
    if(mode!=='all'&&all.length)h+='<a class="btn solid" href="'+cHref(c,'all')+'">View all'+(mode==='sub'?' '+esc(c[0]):'')+' ('+all.length+')</a>';
    h+='</header>';
    h+='<nav class="chips subchips" aria-label="Subcategories"><a class="chip" href="'+cHref(c)+'"'+(mode==='root'?' aria-current="page"':'')+'>Overview</a>'+subs.map(function(sb){return'<a class="chip" href="'+cHref(c,sb.slug)+'"'+(mode==='sub'&&sb.slug===sub.slug?' aria-current="page"':'')+'>'+esc(sb.name)+'</a>'}).join('')+'</nav>';
    function sortBar(n){return'<div class="sortbar"><span class="muted">'+plural(n)+'</span><label>Sort by <select id="cvSort" aria-label="Sort products">'+[['feat','Featured'],['sold','Best selling'],['rate','Top rated'],['lo','Price: low to high'],['hi','Price: high to low']].map(function(o){return'<option value="'+o[0]+'"'+(cv.sort===o[0]?' selected':'')+'>'+o[1]+'</option>'}).join('')+'</select></label></div>'}
    if(mode==='root'){
      h+='<section class="psec" aria-labelledby="cvS"><h2 id="cvS">Shop by subcategory</h2><div class="subgrid">'+subs.map(function(sb){return subTile(c,sb)}).join('')+'</div></section>';
      if(all.length){
        var pop=all.slice().sort(function(a,b){return b.s-a.s}).slice(0,8);
        h+='<section class="psec" aria-labelledby="cvP"><div class="sh"><h2 id="cvP">Popular in '+esc(c[0])+'</h2><a class="more" href="'+cHref(c,'all')+'">View all ('+all.length+')</a></div><div class="grid">'+pop.map(card).join('')+'</div></section>';
      }else{
        h+='<section class="psec">'+catEmpty('Products are coming soon','We have not listed any '+c[0].toLowerCase()+' products yet. In the meantime, browse everything else in the shop.','<a class="btn solid" href="#products">Browse all products</a>')+'</section>';
      }
    }else if(mode==='all'){
      list=sortList(all,cv.sort);
      h+='<section class="psec">'+(list.length?sortBar(list.length)+'<div class="grid">'+list.map(card).join('')+'</div>':catEmpty('No products yet','Nothing is listed in '+c[0]+' right now.','<a class="btn solid" href="#products">Browse all products</a>'))+'</section>';
      h+='<section class="psec" aria-labelledby="cvS"><h2 id="cvS">Browse subcategories</h2><div class="subgrid">'+subs.map(function(sb){return subTile(c,sb)}).join('')+'</div></section>';
    }else{
      list=sortList(subItems(sub),cv.sort);
      h+='<section class="psec">'+(list.length?sortBar(list.length)+'<div class="grid">'+list.map(card).join('')+'</div>':catEmpty('No '+sub.name.toLowerCase()+' yet','This section is empty right now. Check other subcategories below or see everything in '+c[0]+'.',all.length?'<a class="btn solid" href="'+cHref(c,'all')+'">View all '+esc(c[0])+'</a>':'<a class="btn solid" href="#products">Browse all products</a>'))+'</section>';
      var others=subs.filter(function(sb){return sb.slug!==sub.slug});
      if(others.length)h+='<section class="psec" aria-labelledby="cvS"><h2 id="cvS">More in '+esc(c[0])+'</h2><div class="subgrid">'+others.map(function(sb){return subTile(c,sb)}).join('')+'</div></section>';
    }
    $('#categoryView').innerHTML=h+'</div>';
  }
  function showCategory(arg){
    hideAll();var v=$('#categoryView');v.hidden=false;
    var parts=String(arg).split('/'),c=catBy(parts[0]);
    if(!c){v.innerHTML=catNF(parts[0]);document.title='Category not found | Chowk';toTop();return}
    var subs=subsOf(c),mode='root',sub=null;
    if(parts[1]==='all')mode='all';
    else if(parts[1]){
      sub=subs.filter(function(sb){return sb.slug===parts[1]})[0];
      if(!sub){v.innerHTML=catNF(parts[0]+'/'+parts[1]);document.title='Category not found | Chowk';toTop();return}
      mode='sub';
    }
    cv={c:c,subs:subs,mode:mode,sub:sub,key:arg,sort:(cv&&cv.key===arg)?cv.sort:'feat'};
    renderCat();
    document.title=(mode==='sub'?sub.name+' - ':'')+c[0]+' | Chowk';
    toTop();
  }
  $('#categoryView').addEventListener('change',function(e){
    if(e.target.id==='cvSort'&&cv){cv.sort=e.target.value;renderCat();var s=$('#cvSort');if(s)s.focus()}
  });
  document.addEventListener('click',function(e){
    var a=e.target.closest('a[href^="#category-"]');
    if(!a||e.defaultPrevented||e.button||e.metaKey||e.ctrlKey||e.shiftKey)return;
    e.preventDefault();$('#drawerScrim').hidden=true;goTo(a.getAttribute('href'));
  });

  /* ===== My Account + referral family =====
     FRONTEND DEMO: accounts, sessions and referrals live in this browser's localStorage only.
     A real launch needs a server + database (see the note shown on the account pages). */
  var UKEY='chowk-users-v1',SKEY='chowk-session-v1',PKEY='chowk-pending-ref-v1',users=[],refPrompt=false;
  function loadUsers(){var r=null;try{r=JSON.parse(localStorage.getItem(UKEY))}catch(x){}users=Array.isArray(r)?r.filter(function(u){return u&&u.id&&u.login&&u.code}):[]}
  function saveUsers(){try{localStorage.setItem(UKEY,JSON.stringify(users))}catch(x){}}
  function userBy(id){for(var i=0;i<users.length;i++)if(users[i].id===id)return users[i];return null}
  function userByCode(c){c=String(c||'').toUpperCase();for(var i=0;i<users.length;i++)if(users[i].code===c)return users[i];return null}
  function userByLogin(l){for(var i=0;i<users.length;i++)if(users[i].login===l)return users[i];return null}
  function curUser(){var id=null;try{id=localStorage.getItem(SKEY)}catch(x){}if(!id)return null;loadUsers();return userBy(id)}
  function pendingRef(){try{return localStorage.getItem(PKEY)||''}catch(x){return''}}
  function nextCid(){var m=1000;users.forEach(function(u){var k=parseInt(String(u.id).replace(/\D/g,''),10);if(k>m)m=k});return'CUST-'+(m+1)}
  function genCode(){var ch='ABCDEFGHJKLMNPQRSTUVWXYZ23456789',c;do{c='';for(var i=0;i<7;i++)c+=ch.charAt(Math.floor(Math.random()*ch.length))}while(userByCode(c));return c}
  function familyOf(u){return users.filter(function(x){return x.referredBy===u.id}).sort(function(a,b){return a.created-b.created})}
  function refLink(u){return location.href.split('#')[0].split('?')[0]+'?ref='+u.code}
  function normLogin(v){
    v=String(v||'').trim().toLowerCase();
    if(/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v))return v;
    var d=v.replace(/[\s-]/g,'');
    if(/^\+?\d{10,14}$/.test(d)){d=d.replace('+','');if(d.indexOf('92')===0&&d.length===12)d='0'+d.slice(2);return d}
    return'';
  }
  function hashPw(p){
    var enc=null;
    try{enc=new TextEncoder().encode('chowk:'+p)}catch(x){}
    if(enc&&window.crypto&&crypto.subtle&&crypto.subtle.digest){
      return crypto.subtle.digest('SHA-256',enc).then(function(b){return Array.prototype.map.call(new Uint8Array(b),function(x){return('0'+x.toString(16)).slice(-2)}).join('')},function(){return weak(p)});
    }
    return Promise.resolve(weak(p));
  }
  function weak(p){var h=5381;for(var i=0;i<p.length;i++)h=((h<<5)+h+p.charCodeAt(i))|0;return'w'+(h>>>0).toString(16)}
  function fdate(t){return new Date(t).toLocaleDateString('en-PK',{day:'numeric',month:'short',year:'numeric'})}
  function first(n){return String(n||'').split(' ')[0]}
  function openAuth(m){setMode(m);$('#authScrim').hidden=false}
  function authExtras(){
    var n=$('#refNote'),r=pendingRef();$('#authErr').textContent='';$('#forgotLink').hidden=mode!=='login';
    if(mode==='signup'&&r){loadUsers();var ru=userByCode(r);
      n.textContent=ru?'You were invited by '+first(ru.name)+'. Your new account will join their family.':'This invitation code was not found in this browser (demo storage), so your account will be created without a referrer.';
      n.hidden=false}else if(mode==='login'&&loginNotice){n.textContent=loginNotice;n.hidden=false}else n.hidden=true;
  }
  function syncAuthUi(){
    var u=curUser();
    document.querySelectorAll('.actions [data-auth]').forEach(function(b){b.hidden=!!u});
    $('#logoutBtn').hidden=!u;var a=$('#acctBtn');a.hidden=!u;if(u)a.textContent=first(u.name);
    try{locSync()}catch(x){}
  }
  function doneAuth(u,msg){
    loginNotice='';$('#authScrim').hidden=true;$('#authForm').reset();
    try{localStorage.setItem(SKEY,u.id)}catch(x){}
    syncAuthUi();toast(msg);goTo('#account');
  }
  function handleAuth(){
    var err=$('#authErr');err.textContent='';
    var name=$('#fname').value.trim().replace(/\s+/g,' '),lg=normLogin($('#femail').value),pw=$('#fpass').value;
    if(!lg){err.textContent='Enter a valid email address or mobile number.';return}
    if(mode==='signup'&&name.length<2){err.textContent='Enter your full name.';return}
    if(pw.length<8){err.textContent='Password must be at least 8 characters.';return}
    hashPw(pw).then(function(hp){
      loadUsers();var ex=userByLogin(lg);
      if(mode==='login'){
        if(!ex||ex.pass!==hp){err.textContent='Incorrect email/mobile or password.';return}
        doneAuth(ex,'Welcome back, '+first(ex.name)+'.');return;
      }
      if(ex){err.textContent='An account with this email or mobile already exists. Please log in.';return}
      var ref=userByCode(pendingRef()),u={id:nextCid(),name:name,login:lg,pass:hp,code:genCode(),referredBy:(ref&&ref.login!==lg)?ref.id:null,created:Date.now()};
      users.push(u);saveUsers();
      try{localStorage.removeItem(PKEY)}catch(x){}
      doneAuth(u,'Account created. Your Client ID is '+u.id+'.'+(u.referredBy?' You joined '+first(ref.name)+'’s family.':''));
    });
  }
  function logout(){
    try{localStorage.removeItem(SKEY)}catch(x){}
    syncAuthUi();toast('You have been logged out.');
    if(!$('#accountView').hidden)goTo('#top');
  }
  function copyText(t,msg){
    var done=function(){toast(msg||'Copied')};
    var fb=function(){var a=document.createElement('textarea');a.value=t;a.style.cssText='position:fixed;opacity:0';document.body.appendChild(a);a.select();var ok=false;try{ok=document.execCommand('copy')}catch(x){}a.remove();if(ok)done();else toast('Select and copy: '+t)};
    try{navigator.clipboard.writeText(t).then(done,fb)}catch(x){fb()}
  }
  function shareLink(u){
    var url=refLink(u),text='Join me on Chowk Marketplace: cash on delivery and easy returns.';
    if(navigator.share){navigator.share({title:'Join Chowk',text:text,url:url}).catch(function(){})}
    else copyText(url,'Link copied. Paste it into WhatsApp, SMS or social media.');
  }
  function waHref(u){return'https://wa.me/?text='+encodeURIComponent('Join me on Chowk Marketplace: cash on delivery and easy returns. '+refLink(u))}
  var ACCNOTE='<details class="demo"><summary>Demo mode: accounts are saved in this browser only</summary><p>This storefront has no server, so accounts, passwords and referrals are stored in this browser’s localStorage. A referral link therefore only works in the browser where the referrer’s account was created. To make it real for all visitors you need:</p><ul><li>A backend API (sign up, log in, <code>GET /me/family</code>) that checks the referral code on the server</li><li>A database with a users table: client_id, name, email/mobile (unique), password_hash, referral_code (unique), referred_by (foreign key to users), created_at</li><li>Real authentication (hashed passwords, sessions or tokens) so each user can read only their own direct referrals</li><li>Server-side duplicate and self-referral checks, plus optional email or SMS verification</li></ul></details>';
  function crumbA(label){return'<nav class="crumbs" aria-label="Breadcrumb"><a class="lk" href="#top">Home</a><span>&rsaquo;</span><a class="lk" href="#account">My Account</a><span>&rsaquo;</span><b>'+label+'</b></nav>'}
  function accIcon(id){return'<span class="ai">'+ic(id)+'</span>'}
  function refBox(u,withWa){
    return'<div class="linkbox"><input type="text" readonly id="refInput" value="'+esc(refLink(u))+'" aria-label="Your referral link"><button class="btn solid" type="button" data-copy-ref>'+ic('link')+'Copy Link</button><button class="btn" type="button" data-share-ref>'+ic('share')+'Share Link</button>'+(withWa?'<a class="btn" href="'+esc(waHref(u))+'" target="_blank" rel="noopener">WhatsApp</a>':'')+'</div>';
  }
  function renderAccount(sub){
    var u=curUser(),v=$('#accountView'),h;
    if(!u){
      v.innerHTML='<div class="wrap accpage"><div class="empty"><span class="eico">'+ic('user')+'</span><h2>Log in to see your account</h2><p>Your profile, referral link and family members are available once you are logged in.</p><div class="row2"><button class="btn solid" type="button" data-open-auth="login">Login</button><button class="btn" type="button" data-open-auth="signup">Create account</button></div></div></div>';
      return;
    }
    var fam=familyOf(u),n=fam.length,fn=n+(n===1?' Family Member':' Family Members');
    if(sub==='profile'){
      var rb=u.referredBy?userBy(u.referredBy):null;
      h='<div class="wrap accpage">'+crumbA('My Profile')+'<header class="acchead"><span class="avatar">'+esc(u.name.charAt(0).toUpperCase())+'</span><div><h1>My Profile</h1><p class="muted">Your account details</p></div></header>'+
      '<section class="accsec"><dl class="kv"><dt>Name</dt><dd>'+esc(u.name)+'</dd><dt>Client ID</dt><dd>'+esc(u.id)+'</dd><dt>Email / mobile</dt><dd>'+esc(u.login)+'</dd><dt>Member since</dt><dd>'+fdate(u.created)+'</dd><dt>Invited by</dt><dd>'+(rb?esc(first(rb.name)):'Joined directly')+'</dd><dt>Delivery location</dt><dd>'+locProfile()+'</dd></dl></section>'+
      '<section class="accsec"><h2>Edit name</h2><form class="of" data-profile novalidate><label>Full name<input name="name" maxlength="60" value="'+esc(u.name)+'" autocomplete="name"></label><p class="ferr" role="alert"></p><button class="btn solid" type="submit">Save</button></form></section></div>';
    }else if(sub==='family'){
      h='<div class="wrap accpage">'+crumbA('My Family')+'<header class="acchead"><span class="avatar">'+ic('users').replace('class="ico"','class="ico" style="width:30px;height:30px"')+'</span><div><h1>My Family</h1><p class="muted">'+fn+' registered through your referral link</p></div><a class="btn" href="#account/referral">Invite more</a></header>';
      if(!n)h+='<div class="empty"><span class="eico">'+ic('users')+'</span><h2>No family members yet</h2><p>When someone creates an account using your referral link, they will appear here.</p><div class="row2"><button class="btn solid" type="button" data-share-ref>Share your link</button><button class="btn" type="button" data-copy-ref>Copy Link</button></div></div>';
      else h+='<section class="accsec" style="margin-top:0"><table class="ftable"><thead><tr><th>Serial Number</th><th>Client ID</th><th>Customer Name</th><th>Registration Date</th></tr></thead><tbody>'+fam.map(function(f,i){return'<tr><td class="sn" data-l="Serial Number">'+(i+1)+'</td><td data-l="Client ID">'+esc(f.id)+'</td><td data-l="Customer Name">'+esc(f.name)+'</td><td data-l="Registration Date">'+fdate(f.created)+'</td></tr>'}).join('')+'</tbody></table></section>';
      h+=ACCNOTE+'</div>';
    }else if(sub==='referral'){
      h='<div class="wrap accpage">'+crumbA('My Referral Link')+'<header class="acchead"><span class="avatar">'+ic('link').replace('class="ico"','class="ico" style="width:30px;height:30px"')+'</span><div><h1>My Referral Link</h1><p class="muted">Your code: <b>'+esc(u.code)+'</b></p></div></header>'+
      '<section class="accsec" style="margin-top:0"><h2>Share your link</h2>'+refBox(u,true)+'</section>'+
      '<section class="accsec"><h2>How it works</h2><ol class="how"><li><b>Share</b> your link with friends and relatives.</li><li>They open it and <b>create an account</b>. The new account is connected to yours automatically.</li><li>They appear in <a class="lk" href="#account/family">My Family</a>. You currently have <b>'+fn+'</b>.</li></ol></section>'+ACCNOTE+'</div>';
    }else{
      h='<div class="wrap accpage"><header class="acchead"><span class="avatar">'+esc(u.name.charAt(0).toUpperCase())+'</span><div><h1>Hello, '+esc(first(u.name))+'</h1><p class="muted">Client ID: '+esc(u.id)+'</p></div><button class="btn" type="button" data-logout>Logout</button></header>'+
      '<div class="accgrid">'+
      '<a class="acard" href="#account/profile">'+accIcon('user')+'<h2>My Profile</h2><p>'+esc(u.name)+'<br>'+esc(u.login)+'</p><span class="go">View profile &rsaquo;</span></a>'+
      '<a class="acard" href="#account/family">'+accIcon('users')+'<h2>My Family</h2><span class="bignum" id="famNum">'+n+'</span><p>'+(n===1?'Family Member':'Family Members')+'</p><span class="go">View family list &rsaquo;</span></a>'+
      '<a class="acard" href="#account/family">'+accIcon('users')+'<h2>Total Family Members</h2><span class="bignum">'+n+'</span><p>People who registered using your referral link</p><span class="go">See who joined &rsaquo;</span></a>'+
      '<section class="acard refc" data-ref-card aria-label="My Referral Link">'+accIcon('link')+'<h2>My Referral Link</h2><p>Share this link. Anyone who creates an account through it joins your family.</p>'+refBox(u,false)+'<span class="go">More sharing options &rsaquo;</span></section>'+
      '<a class="acard" href="#orders">'+accIcon('truck')+'<h2>My Orders</h2><p>Track your orders and delivery progress.</p><span class="go">Track orders &rsaquo;</span></a>'+
      '</div>'+ACCNOTE+'</div>';
    }
    v.innerHTML=h;
  }
  function showAccount(sub){
    hideAll();$('#accountView').hidden=false;
    renderAccount(sub);
    document.title=({profile:'My Profile',family:'My Family',referral:'My Referral Link'}[sub]||'My Account')+' | Chowk';
    toTop();
  }
  $('#accountView').addEventListener('click',function(e){
    var oa=e.target.closest('[data-open-auth]');if(oa){openAuth(oa.dataset.openAuth);return}
    var u=curUser();if(!u)return;
    if(e.target.closest('[data-logout]')){logout();return}
    if(e.target.closest('[data-copy-ref]')){copyText(refLink(u),'Referral link copied');return}
    if(e.target.closest('[data-share-ref]')){shareLink(u);return}
    var rc=e.target.closest('[data-ref-card]');
    if(rc&&!e.target.closest('button,input,a'))goTo('#account/referral');
  });
  $('#accountView').addEventListener('focusin',function(e){if(e.target.id==='refInput')e.target.select()});
  $('#accountView').addEventListener('submit',function(e){
    e.preventDefault();var f=e.target;if(!f.hasAttribute('data-profile'))return;
    var u=curUser(),er=f.querySelector('.ferr'),nm=f.elements.name.value.trim().replace(/\s+/g,' ');
    if(!u)return;if(nm.length<2){er.textContent='Enter your full name.';return}
    u.name=nm;saveUsers();syncAuthUi();toast('Profile updated.');renderAccount('profile');
  });
  $('#logoutBtn').addEventListener('click',logout);
  document.addEventListener('click',function(e){
    var a=e.target.closest('a[href="#account"],a[href^="#account/"]');
    if(!a||e.defaultPrevented||e.button||e.metaKey||e.ctrlKey||e.shiftKey)return;
    e.preventDefault();goTo(a.getAttribute('href'));
  });
  /* when logged in, sign-up/login buttons (e.g. the affiliate banner) just open the account */
  document.addEventListener('click',function(e){
    var b=e.target.closest('[data-auth]');
    if(b&&curUser()){e.stopPropagation();e.preventDefault();goTo('#account')}
  },true);
  window.addEventListener('storage',function(e){
    if(e.key!==UKEY&&e.key!==SKEY)return;
    syncAuthUi();if(!$('#accountView').hidden)route();
  });
  function captureRef(){
    var r=null;try{r=new URLSearchParams(location.search).get('ref')}catch(x){}
    if(!r)return;
    r=r.toUpperCase().replace(/[^A-Z0-9]/g,'').slice(0,12);if(!r)return;
    try{localStorage.setItem(PKEY,r)}catch(x){}
    try{history.replaceState(null,'',location.pathname+location.hash)}catch(x){}
    refPrompt=true;
  }


  /* ===== Forgot / Reset password =====
     Uses the same users store as Login / Sign up. Two providers:
     - window.CHOWK_API_BASE set  -> real backend (server/): emailed link, hashed single-use tokens in the database
     - empty                      -> browser-only demo (localStorage); no email can be sent from a static page */
  var RKEY='chowk-reset-v1',RTTL=30*60000,API=String(window.CHOWK_API_BASE||'').replace(/\/+$/,''),ap={timer:null};
  var OKMSG='Your password has been reset successfully. Please log in with your new password.';
  var RMSG={invalid:'This password reset link is invalid. Please request a new one.',expired:'This password reset link has expired. Reset links are valid for 30 minutes. Please request a new one.',used:'This password reset link has already been used. Request a new one if you still need to reset your password.',network:'We could not reach the server. Check your internet connection and try again.',rate:'Too many attempts. Please wait a few minutes and try again.',server:'Something went wrong on our side. Please try again in a few minutes.'};
  function failMsg(r){return RMSG[r.reason]||r.message||RMSG.server}
  function pwIssues(p){var m=[];if(p.length<8)m.push('at least 8 characters');if(!/[A-Za-z]/.test(p))m.push('at least one letter');if(!/[0-9]/.test(p))m.push('at least one number');if(p.length>128)m.push('no more than 128 characters');return m}
  function apiCall(method,path,body){
    return fetch(API+path,{method:method,headers:{'Content-Type':'application/json'},body:body?JSON.stringify(body):undefined,credentials:'omit'}).then(function(r){
      return r.json().catch(function(){return{}}).then(function(j){if(!r.ok&&j.ok!==false)j.ok=false;if(!r.ok&&!j.reason)j.reason=r.status===429?'rate':'server';return j});
    },function(){return{ok:false,reason:'network'}});
  }
  function loadTok(){try{var r=JSON.parse(localStorage.getItem(RKEY));return Array.isArray(r)?r:[]}catch(x){return[]}}
  function saveTok(a){try{localStorage.setItem(RKEY,JSON.stringify(a))}catch(x){}}
  function newToken(){var a=new Uint8Array(32);crypto.getRandomValues(a);return Array.prototype.map.call(a,function(x){return('0'+x.toString(16)).slice(-2)}).join('')}
  function localCheck(tok){
    return hashPw('reset:'+tok).then(function(h){
      var t=loadTok().filter(function(x){return x.h===h})[0];
      if(!t)return{ok:false,reason:'invalid'};
      if(t.used)return{ok:false,reason:'used'};
      if(t.exp<Date.now())return{ok:false,reason:'expired'};
      loadUsers();var u=userBy(t.uid);if(!u)return{ok:false,reason:'invalid'};
      return{ok:true,u:u};
    });
  }
  function checkToken(tok){
    if(!tok||tok.length<32)return Promise.resolve({ok:false,reason:'invalid'});
    return API?apiCall('GET','/api/auth/reset-password/validate?token='+encodeURIComponent(tok)):localCheck(tok);
  }
  function requestReset(email){
    if(API)return apiCall('POST','/api/auth/forgot-password',{email:email});
    loadUsers();var u=userByLogin(email);
    if(!u)return Promise.resolve({ok:true});
    var tok=newToken();
    return hashPw('reset:'+tok).then(function(h){
      var a=loadTok().filter(function(t){return t.exp>Date.now()-86400000});
      a.forEach(function(t){if(t.uid===u.id)t.used=true});
      a.push({h:h,uid:u.id,exp:Date.now()+RTTL,used:false});saveTok(a);
      return{ok:true,demoLink:location.href.split('#')[0].split('?')[0]+'#reset-password/'+tok};
    });
  }
  function performReset(tok,pw,pw2){
    if(API)return apiCall('POST','/api/auth/reset-password',{token:tok,password:pw,confirmPassword:pw2});
    return localCheck(tok).then(function(r){
      if(!r.ok)return r;
      return hashPw(pw).then(function(hp){
        if(hp===r.u.pass)return{ok:false,reason:'same',message:'Your new password must be different from your old password.'};
        r.u.pass=hp;saveUsers();
        var a=loadTok();a.forEach(function(t){if(t.uid===r.u.id)t.used=true});saveTok(a);
        var sid=null;try{sid=localStorage.getItem(SKEY)}catch(x){}
        if(sid===r.u.id){try{localStorage.removeItem(SKEY)}catch(x){}syncAuthUi()}
        return{ok:true,email:r.u.login};
      });
    });
  }
  function eyeBtn(){return'<button class="eye" type="button" data-eye aria-label="Show password" aria-pressed="false">'+ic('eye')+'</button>'}
  function pwField(id,label,ac){return'<label>'+label+'<span class="pwf"><input id="'+id+'" type="password" autocomplete="'+ac+'" maxlength="128" placeholder="Enter password">'+eyeBtn()+'</span></label>'}
  function cardWrap(inner,bad){return'<div class="wrap apage"><div class="acard2'+(bad?' bad':'')+'">'+inner+'</div></div>'}
  function forgotHtml(){
    var pre='';try{var e=$('#femail').value.trim();if(/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(e))pre=e}catch(x){}
    return cardWrap('<span class="eico">'+ic('mail')+'</span><h1>Forgot your password?</h1><p>Enter the email address you registered with. We will send you a secure link to reset your password.</p>'+
      '<form class="of" id="fpForm" novalidate><label>Email address<input id="fpEmail" type="email" inputmode="email" autocomplete="email" autocapitalize="off" spellcheck="false" placeholder="you@example.com" value="'+esc(pre)+'"></label><p class="ferr" id="fpErr" role="alert"></p><button class="btn solid" type="submit" id="fpBtn">Send reset link</button></form>'+
      '<button class="back" type="button" data-to-login>'+ic('back')+'Back to login</button>');
  }
  function sentHtml(em,demoLink){
    var demo='';
    if(!API)demo='<div class="demo"><b>Demo mode: no email service is connected.</b><p>This site runs in your browser only, so it cannot send email. '+(demoLink?'This is the link that would have been emailed:':'No account with this email exists in this browser.')+'</p>'+(demoLink?'<a class="btn solid" href="'+esc(demoLink)+'">Open reset link</a>':'')+'</div>';
    return cardWrap('<span class="eico">'+ic('check')+'</span><h1>Check your email</h1><p class="succ">If an account exists for <b>'+esc(em)+'</b>, we have sent a password reset link. The link expires in 30 minutes and works only once.</p><p>Not there? Check your spam folder, or try again.</p>'+demo+
      '<button class="btn" type="button" data-again>Use a different email</button><button class="back" type="button" data-to-login>'+ic('back')+'Back to login</button>');
  }
  function badHtml(reason){
    return cardWrap('<span class="eico">'+ic('lock')+'</span><h1>Link not valid</h1><p role="alert">'+esc(RMSG[reason]||RMSG.invalid)+'</p><a class="btn solid" href="#forgot-password">Request a new link</a><button class="back" type="button" data-to-login>'+ic('back')+'Back to login</button>',true);
  }
  function resetHtml(){
    return cardWrap('<span class="eico">'+ic('lock')+'</span><h1>Reset your password</h1><p>Choose a new password for your account.</p>'+
      '<form class="of" id="rpForm" novalidate>'+pwField('rpPw','New password','new-password')+pwField('rpPw2','Confirm new password','new-password')+
      '<ul class="rules" id="rpRules"><li data-r="len">At least 8 characters</li><li data-r="ltr">At least one letter</li><li data-r="num">At least one number</li></ul><p class="mstat" id="rpMatch" aria-live="polite"></p>'+
      '<p class="ferr" id="rpErr" role="alert"></p><button class="btn solid" type="submit" id="rpBtn">Reset password</button></form>');
  }
  function doneHtml(){
    return cardWrap('<span class="eico">'+ic('check')+'</span><h1>Password reset</h1><p class="succ" role="status">'+OKMSG+'</p><p>Taking you to the login page in <b id="rdCount">5</b> seconds.</p><button class="btn solid" type="button" data-to-login>Go to login now</button>');
  }
  function stopTimer(){if(ap.timer){clearInterval(ap.timer);ap.timer=null}}
  function toLogin(email,notice){
    stopTimer();loginNotice=notice||'';
    if(location.hash!=='#top'){try{location.hash='top'}catch(x){}}
    showHome();toTop();openAuth('login');
    if(email)$('#femail').value=email;
    $('#fpass').focus();
  }
  function showAuthPage(kind,tok){
    stopTimer();hideAll();var v=$('#authPageView');v.hidden=false;toTop();
    if(kind==='forgot'){document.title='Forgot password | Chowk';v.innerHTML=forgotHtml();return}
    document.title='Reset password | Chowk';
    tok=decodeURIComponent(tok||'').replace(/[^A-Za-z0-9]/g,'');
    v.innerHTML='<div class="wrap apage" aria-busy="true" role="status"><span class="sr">Checking your reset link</span><div class="skel" style="max-width:480px;margin:0 auto;height:280px"></div></div>';
    checkToken(tok).then(function(r){
      if(v.hidden||location.hash.indexOf('#reset-password')!==0)return;
      if(!r.ok){v.innerHTML=badHtml(r.reason==='network'?'network':r.reason);return}
      ap.tok=tok;v.innerHTML=resetHtml();var f=$('#rpPw');if(f)f.focus();
    }).catch(function(){if(!v.hidden)v.innerHTML=badHtml('server')});
  }
  function rpUpdate(){
    var p=$('#rpPw').value,q=$('#rpPw2').value,ok={len:p.length>=8,ltr:/[A-Za-z]/.test(p),num:/[0-9]/.test(p)};
    document.querySelectorAll('#rpRules li').forEach(function(li){li.classList.toggle('ok',!!ok[li.dataset.r])});
    var m=$('#rpMatch');
    if(!q){m.textContent='';m.className='mstat'}
    else if(p===q){m.textContent='Passwords match.';m.className='mstat ok'}
    else{m.textContent='Passwords do not match.';m.className='mstat bad'}
  }
  var apv=$('#authPageView');
  apv.addEventListener('input',function(e){if(e.target.id==='rpPw'||e.target.id==='rpPw2')rpUpdate()});
  apv.addEventListener('click',function(e){
    var eye=e.target.closest('[data-eye]');
    if(eye){
      var inp=eye.parentNode.querySelector('input'),show=inp.type==='password';
      inp.type=show?'text':'password';eye.setAttribute('aria-pressed',show);eye.setAttribute('aria-label',show?'Hide password':'Show password');
      eye.innerHTML=ic(show?'eyeoff':'eye');inp.focus();return;
    }
    if(e.target.closest('[data-to-login]')){toLogin();return}
    if(e.target.closest('[data-again]')){apv.innerHTML=forgotHtml();$('#fpEmail').value='';$('#fpEmail').focus()}
  });
  apv.addEventListener('submit',function(e){
    e.preventDefault();var f=e.target;
    if(f.id==='fpForm'){
      var em=$('#fpEmail').value.trim().toLowerCase(),er=$('#fpErr'),btn=$('#fpBtn');er.textContent='';
      if(!em){er.textContent='Enter your email address.';return}
      if(!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(em)){er.textContent='Enter a valid email address, for example name@example.com.';return}
      btn.disabled=true;btn.textContent='Sending...';
      requestReset(em).then(function(r){
        if(!r.ok){btn.disabled=false;btn.textContent='Send reset link';er.textContent=failMsg(r);return}
        apv.innerHTML=sentHtml(em,r.demoLink);
      }).catch(function(){btn.disabled=false;btn.textContent='Send reset link';er.textContent=RMSG.server});
      return;
    }
    if(f.id==='rpForm'){
      var p=$('#rpPw').value,q=$('#rpPw2').value,er2=$('#rpErr'),b2=$('#rpBtn'),is=pwIssues(p);er2.textContent='';
      if(!p){er2.textContent='Enter a new password.';return}
      if(is.length){er2.textContent='Your password needs '+is.join(', ')+'.';return}
      if(!q){er2.textContent='Confirm your new password.';return}
      if(p!==q){er2.textContent='Passwords do not match. Please re-enter them.';return}
      b2.disabled=true;b2.textContent='Resetting...';
      performReset(ap.tok,p,q).then(function(r){
        if(r.ok){
          var email=r.email||'';ap.tok=null;apv.innerHTML=doneHtml();toast('Password reset successfully.');
          var n=5;stopTimer();
          ap.timer=setInterval(function(){
            if(apv.hidden){stopTimer();return}
            n--;var c=$('#rdCount');if(c)c.textContent=n;
            if(n<=0)toLogin(email,OKMSG);
          },1000);
          apv.querySelector('[data-to-login]').onclick=function(ev){ev.stopPropagation();toLogin(email,OKMSG)};
          return;
        }
        if(r.reason==='invalid'||r.reason==='expired'||r.reason==='used'){apv.innerHTML=badHtml(r.reason);return}
        b2.disabled=false;b2.textContent='Reset password';er2.textContent=failMsg(r);
      }).catch(function(){b2.disabled=false;b2.textContent='Reset password';er2.textContent=RMSG.server});
    }
  });
  document.addEventListener('click',function(e){
    var fl=e.target.closest('#forgotLink');
    if(fl){e.preventDefault();$('#authScrim').hidden=true;goTo('#forgot-password');return}
    var a=e.target.closest('a[href="#forgot-password"],a[href^="#reset-password"]');
    if(!a||e.defaultPrevented||e.button||e.metaKey||e.ctrlKey||e.shiftKey)return;
    e.preventDefault();goTo(a.getAttribute('href'));
  });

  /* ===== Set Location: delivery location, availability, charges and estimated delivery =====
     - Saved on the logged-in customer's record (u.loc, in the same users store as accounts and referrals).
       Guests are remembered on this device and moved into the account at their next login.
     - Delivery rules live in LOC_ZONES / LOC_CITIES below. Change the fees and days to match your couriers.
     - "Search" and "Use my current location" call OpenStreetMap Nominatim (free, no API key).
       Point window.CHOWK_GEOCODER_BASE at your own proxy or provider before you expect heavy traffic.
       If the network is unavailable, the built-in list of Pakistani cities and areas is searched instead. */
  var LOC_GKEY='chowk-loc-v1',LOC_FREE=2500,LOC=null,locMem=null,locReady=false;
  var LOC_NOM=String(window.CHOWK_GEOCODER_BASE||'https://nominatim.openstreetmap.org').replace(/\/+$/,'');
  var LOC_ZONES={
    metro:{fee:149,min:2,max:3},   /* Karachi, Lahore, Islamabad, Rawalpindi */
    major:{fee:199,min:3,max:5},   /* large cities: same as the store's original flat rate */
    remote:{fee:299,min:5,max:8}   /* smaller towns and remote regions */
  };
  var LOC_OK={PK:1};               /* country codes we deliver to */
  var LOC_CTRY=[['PK','Pakistan'],['AE','United Arab Emirates'],['SA','Saudi Arabia'],['QA','Qatar'],['KW','Kuwait'],['OM','Oman'],['BH','Bahrain'],['GB','United Kingdom'],['US','United States'],['CA','Canada'],['AU','Australia'],['DE','Germany'],['FR','France'],['TR','Türkiye'],['MY','Malaysia'],['SG','Singapore'],['CN','China'],['IN','India'],['BD','Bangladesh'],['AF','Afghanistan']];
  /* name, province, zone, latitude, longitude */
  var LOC_CITIES=[
    ['Karachi','Sindh','metro',24.8607,67.0011],['Lahore','Punjab','metro',31.5204,74.3587],
    ['Islamabad','Islamabad Capital Territory','metro',33.6844,73.0479],['Rawalpindi','Punjab','metro',33.5651,73.0169],
    ['Faisalabad','Punjab','major',31.4504,73.1350],['Multan','Punjab','major',30.1575,71.5249],
    ['Gujranwala','Punjab','major',32.1877,74.1945],['Sialkot','Punjab','major',32.4945,74.5229],
    ['Sargodha','Punjab','major',32.0740,72.6861],['Bahawalpur','Punjab','major',29.3956,71.6836],
    ['Sahiwal','Punjab','major',30.6682,73.1114],['Sheikhupura','Punjab','major',31.7167,73.9850],
    ['Gujrat','Punjab','major',32.5742,74.0754],['Kasur','Punjab','major',31.1156,74.4467],
    ['Okara','Punjab','major',30.8138,73.4534],['Rahim Yar Khan','Punjab','major',28.4202,70.2952],
    ['Jhang','Punjab','major',31.2681,72.3181],['Dera Ghazi Khan','Punjab','major',30.0561,70.6403],
    ['Jhelum','Punjab','major',32.9425,73.7257],['Chiniot','Punjab','major',31.7200,72.9789],
    ['Wah Cantt','Punjab','major',33.7715,72.7511],['Taxila','Punjab','major',33.7463,72.8397],
    ['Attock','Punjab','major',33.7660,72.3609],['Hafizabad','Punjab','major',32.0709,73.6880],
    ['Peshawar','Khyber Pakhtunkhwa','major',34.0151,71.5249],['Mardan','Khyber Pakhtunkhwa','major',34.1989,72.0231],
    ['Abbottabad','Khyber Pakhtunkhwa','major',34.1688,73.2215],['Kohat','Khyber Pakhtunkhwa','major',33.5869,71.4414],
    ['Hyderabad','Sindh','major',25.3960,68.3578],['Sukkur','Sindh','major',27.7052,68.8574],
    ['Larkana','Sindh','major',27.5570,68.2028],['Nawabshah','Sindh','major',26.2442,68.4100],
    ['Mirpur Khas','Sindh','major',25.5251,69.0159],['Quetta','Balochistan','major',30.1798,66.9750],
    ['Mingora','Khyber Pakhtunkhwa','remote',34.7717,72.3600],['Bannu','Khyber Pakhtunkhwa','remote',32.9889,70.6056],
    ['Dera Ismail Khan','Khyber Pakhtunkhwa','remote',31.8313,70.9017],['Murree','Punjab','remote',33.9070,73.3943],
    ['Jacobabad','Sindh','remote',28.2769,68.4514],['Muzaffarabad','Azad Kashmir','remote',34.3700,73.4711],
    ['Gilgit','Gilgit-Baltistan','remote',35.9208,74.3089],['Skardu','Gilgit-Baltistan','remote',35.2971,75.6339],
    ['Gwadar','Balochistan','remote',25.1216,62.3254],['Turbat','Balochistan','remote',26.0012,63.0544],
    ['Khuzdar','Balochistan','remote',27.8000,66.6167]
  ];
  var LOC_AREAS={
    'Karachi':['Gulshan-e-Iqbal','Gulistan-e-Johar','DHA','Clifton','Saddar','North Nazimabad','Nazimabad','PECHS','Bahadurabad','Korangi','Malir','Landhi','Federal B Area','Scheme 33','Shah Faisal Colony','Lyari','Bin Qasim','Gulberg','North Karachi','Orangi Town'],
    'Lahore':['DHA','Gulberg','Johar Town','Model Town','Bahria Town','Iqbal Town','Wapda Town','Samanabad','Garden Town','Cantt','Faisal Town','Township','Shadman','Valencia Town','Allama Iqbal Town','Askari'],
    'Islamabad':['F-6','F-7','F-8','F-10','F-11','G-9','G-10','G-11','G-13','E-11','I-8','I-10','Blue Area','DHA','Bahria Town','Gulberg Greens','Bani Gala','PWD','Saidpur'],
    'Rawalpindi':['Saddar','Satellite Town','Bahria Town','DHA','Chaklala','Westridge','Commercial Market','Raja Bazaar','Adiala Road','Peshawar Road'],
    'Faisalabad':['People’s Colony','D Ground','Madina Town','Samanabad','Jinnah Colony','Gulberg','Satiana Road','Canal Road'],
    'Multan':['Gulgasht Colony','Cantt','Shah Rukn-e-Alam Colony','Bosan Road','Nawan Shehr'],
    'Peshawar':['University Town','Hayatabad','Saddar','Gulbahar','Cantt','Ring Road'],
    'Hyderabad':['Latifabad','Qasimabad','Hirabad','Cantt','Autobahn Road'],
    'Quetta':['Satellite Town','Jinnah Town','Cantt','Sariab Road','Airport Road']
  };
  var LOC_ALIAS={'dg khan':'Dera Ghazi Khan','d g khan':'Dera Ghazi Khan','di khan':'Dera Ismail Khan','d i khan':'Dera Ismail Khan','wah':'Wah Cantt','wah cantonment':'Wah Cantt','swat':'Mingora','shaheed benazirabad':'Nawabshah','ict':'Islamabad','islamabad capital territory':'Islamabad'};

  function locNorm(s){return String(s==null?'':s).toLowerCase().replace(/[^a-z0-9]+/g,' ').replace(/^ +| +$/g,'')}
  function locCityRec(name){
    var k=locNorm(name);if(!k)return null;
    var n=' '+(LOC_ALIAS[k]?locNorm(LOC_ALIAS[k]):k)+' ';
    for(var i=0;i<LOC_CITIES.length;i++){if(n.indexOf(' '+locNorm(LOC_CITIES[i][0])+' ')>-1)return LOC_CITIES[i]}
    return null;
  }
  function locCcOf(l){
    var cc=String(l&&l.cc||'').toUpperCase();
    if(!cc&&l&&l.country){for(var i=0;i<LOC_CTRY.length;i++){if(locNorm(LOC_CTRY[i][1])===locNorm(l.country))cc=LOC_CTRY[i][0]}}
    return cc;
  }
  /* availability + shipping rule for a location; null when no city is known yet */
  function locInfo(l){
    if(!l||!l.city)return null;
    var cc=locCcOf(l);
    if(!LOC_OK[cc])return{ok:false,reason:'We don’t deliver to '+(l.country||'this country')+' yet. Delivery is currently available within Pakistan only.'};
    var rec=locCityRec(l.city),z=LOC_ZONES[rec?rec[2]:'remote'];
    return{ok:true,fee:z.fee,min:z.min,max:z.max,known:!!rec};
  }
  function locFee(){var i=locInfo(LOC);return i&&i.ok?i.fee:199}
  function etaDays(){var i=locInfo(LOC);return i&&i.ok?[i.min,i.max]:[3,5]}
  function etaText(){var d=etaDays();return d[0]+' to '+d[1]+' working days'}
  function locDates(min,max){
    var a=new Date(),b=new Date(),f={weekday:'short',day:'numeric',month:'short'};
    a.setDate(a.getDate()+min);b.setDate(b.getDate()+max);
    return a.toLocaleDateString('en-PK',f)+' to '+b.toLocaleDateString('en-PK',f);
  }
  function locShort(l){
    var s=(l.area?l.area+', ':'')+l.city;
    if(locCcOf(l)!=='PK'&&l.country)s+=', '+l.country;
    return s;
  }
  function locLine(l){var o=[],seen={};[l.address,l.area,l.city,l.state,l.country].forEach(function(p){var k=locNorm(p);if(p&&!seen[k]){seen[k]=1;o.push(p)}});return o.join(', ')}

  /* ---- storage: account record when logged in, this device when not ---- */
  function locGuest(){
    var r=null;try{r=JSON.parse(localStorage.getItem(LOC_GKEY))}catch(x){}
    if(!(r&&r.city))r=locMem;
    return r&&r.city?r:null;
  }
  function locRead(){var u=curUser();if(u)return u.loc&&u.loc.city?u.loc:null;return locGuest()}
  function locWrite(l){
    var u=curUser();
    if(u){if(l)u.loc=l;else delete u.loc;saveUsers();return true}
    locMem=l;
    try{if(l)localStorage.setItem(LOC_GKEY,JSON.stringify(l));else localStorage.removeItem(LOC_GKEY)}catch(x){}
    return false;
  }
  function locRender(){
    var b=$('#locBtn'),t=$('#locText'),s=$('#locSmall');if(!b)return;
    if(!LOC){b.className='locbtn';s.textContent='Deliver to';t.textContent='Set location';b.setAttribute('aria-label','Set delivery location');b.title='Set your delivery location';return}
    var i=locInfo(LOC),bad=!!(i&&!i.ok);
    b.className='locbtn set'+(bad?' warn':'');
    s.textContent=bad?'Not deliverable to':'Deliver to';
    t.textContent=locShort(LOC);
    b.setAttribute('aria-label','Delivery location: '+locShort(LOC)+(bad?' (we do not deliver here)':'')+'. Change location');
    b.title=locLine(LOC)+' (click to change)';
  }
  function locRefresh(){
    if(!locReady)return;
    try{
      if(!$('#cartView').hidden)renderCart();
      else if(!$('#productView').hidden&&pd&&pd.p)renderPdp();
      else if(!$('#accountView').hidden)route();
    }catch(x){}
  }
  /* called from syncAuthUi(): on page load, login, logout and cross-tab changes */
  function locSync(){
    var u=curUser(),g=locGuest();
    if(u&&!(u.loc&&u.loc.city)&&g){u.loc=g;saveUsers();locMem=null;try{localStorage.removeItem(LOC_GKEY)}catch(x){}}
    var nx=locRead(),ch=JSON.stringify(nx)!==JSON.stringify(LOC);
    LOC=nx;locRender();
    if(ch)locRefresh();
  }

  /* ---- small helpers used by the cart, product page, profile and checkout ---- */
  function locTag(){
    if(!LOC)return'<br><small class="loc-tag"><button type="button" class="lk" data-loc-open>Set your location</button> for exact delivery details</small>';
    var i=locInfo(LOC);
    if(i&&!i.ok)return'<br><small class="loc-tag warn">Not deliverable to '+esc(locShort(LOC))+'. <button type="button" class="lk" data-loc-open>Change location</button></small>';
    return'<br><small class="loc-tag">To '+esc(locShort(LOC))+' &middot; <button type="button" class="lk" data-loc-open>Change</button></small>';
  }
  function locProfile(){
    if(!LOC)return'Not set <button type="button" class="lk" data-loc-open>Set location</button>';
    return esc(locLine(LOC))+' <button type="button" class="lk" data-loc-open>Change</button>';
  }
  function locOrderAddr(){return LOC?[LOC.address,LOC.area].filter(Boolean).join(', ')||DEMO.addr:DEMO.addr}
  function locOrderCity(){return LOC?LOC.city:DEMO.city}
  function locCheckout(){
    if(!LOC){openLoc('Choose where we should deliver your order, then press Checkout again.');return false}
    var i=locInfo(LOC);
    if(i&&!i.ok){openLoc(i.reason+' Choose a delivery address in Pakistan to place this order.','warn');return false}
    return true;
  }

  /* ---- geocoding (OpenStreetMap Nominatim) ---- */
  function locFromNom(r){
    var a=r.address||{},cc=String(a.country_code||'').toUpperCase(),
        cands=[a.city,a.town,a.municipality,a.county,a.state_district,a.village,a.city_district],city='',i,rec;
    for(i=0;i<cands.length;i++){if(cands[i]){rec=locCityRec(cands[i]);if(rec){city=rec[0];break}}}
    if(!city){for(i=0;i<cands.length;i++){if(cands[i]){city=cands[i];break}}}
    var area=a.suburb||a.neighbourhood||a.quarter||a.residential||a.city_district||a.hamlet||'';
    if(locNorm(area)===locNorm(city))area='';
    var street=[a.house_number,a.road].filter(Boolean).join(' '),
        poi=r.name&&r.category&&['place','boundary','highway','waterway','natural','landuse'].indexOf(r.category)<0,
        addr=poi?[r.name,street].filter(Boolean).join(', '):street;
    rec=locCityRec(city);
    return{country:cc==='PK'?'Pakistan':(a.country||''),cc:cc,state:a.state||(rec?rec[1]:''),city:city,area:area,address:addr,name:r.name||'',lat:+r.lat,lon:+r.lon};
  }
  function locFetch(path,ms){
    var ctl=window.AbortController?new AbortController():null,to=setTimeout(function(){if(ctl)ctl.abort()},ms||8000);
    return fetch(LOC_NOM+path,{signal:ctl?ctl.signal:undefined,headers:{'Accept':'application/json'}}).then(function(r){
      clearTimeout(to);if(!r.ok)throw new Error('http '+r.status);return r.json();
    },function(e){clearTimeout(to);throw e});
  }
  function locHav(a,b,c,d){var p=Math.PI/180,x=(c-a)*p,y=(d-b)*p,h=Math.sin(x/2)*Math.sin(x/2)+Math.cos(a*p)*Math.cos(c*p)*Math.sin(y/2)*Math.sin(y/2);return 12742*Math.asin(Math.sqrt(h))}
  /* offline fallback for GPS: the nearest built-in city, if one is close enough */
  function locNearest(lat,lon){
    var best=null,bd=1e9;
    LOC_CITIES.forEach(function(c){var d=locHav(lat,lon,c[3],c[4]);if(d<bd){bd=d;best=c}});
    if(best&&bd<=50)return{country:'Pakistan',cc:'PK',state:best[1],city:best[0],area:'',address:'',lat:lat,lon:lon,near:true};
    if(lat>23.5&&lat<37.2&&lon>60.8&&lon<77.9)return{country:'Pakistan',cc:'PK',state:'',city:'',area:'',address:'',lat:lat,lon:lon,near:true};
    return{country:'',cc:'',state:'',city:'',area:'',address:'',lat:lat,lon:lon,near:true};
  }
  function locLocal(q){
    var toks=locNorm(q).split(' ').filter(Boolean),out=[];if(!toks.length||locNorm(q).length<2)return out;
    function hit(h){for(var i=0;i<toks.length;i++){if((' '+h).indexOf(' '+toks[i])<0)return false}return true}
    LOC_CITIES.forEach(function(c){
      if(hit(locNorm(c[0]+' '+c[1])))out.push({title:c[0],sub:c[1]+', Pakistan',d:{country:'Pakistan',cc:'PK',state:c[1],city:c[0],area:'',address:'',lat:c[3],lon:c[4]},rank:locNorm(c[0]).indexOf(toks[0])===0?0:1});
    });
    Object.keys(LOC_AREAS).forEach(function(city){
      var rec=locCityRec(city);
      LOC_AREAS[city].forEach(function(a){
        if(hit(locNorm(a+' '+city)))out.push({title:a+', '+city,sub:'Area in '+city+', '+rec[1],d:{country:'Pakistan',cc:'PK',state:rec[1],city:city,area:a,address:'',lat:null,lon:null},rank:locNorm(a).indexOf(toks[0])===0?0:2});
      });
    });
    out.sort(function(x,y){return x.rank-y.rank});
    return out.slice(0,6);
  }

  /* ---- modal ---- */
  var lm={tab:'search',open:false,prev:null,items:[],act:-1,seq:0,gseq:0,timer:null,ctl:null,state:'',lat:null,lon:null,src:'manual'};
  function lmMsg(kind,text){var m=$('#locMsg');if(!text){m.hidden=true;m.textContent='';return}m.className='lm-msg '+kind;m.textContent=text;m.hidden=false}
  function lmTab(t){
    lm.tab=t;
    $('#locTabSearch').setAttribute('aria-selected',t==='search');$('#locTabManual').setAttribute('aria-selected',t==='manual');
    $('#locPanelSearch').hidden=t!=='search';$('#locForm').hidden=t!=='manual';
  }
  function lmErrs(c,a){
    $('#locCityE').textContent=c||'';$('#locAddrE').textContent=a||'';
    $('#locCity').setAttribute('aria-invalid',c?'true':'false');$('#locAddr').setAttribute('aria-invalid',a?'true':'false');
  }
  function lmRead(){
    var sel=$('#locCountry'),v=sel.value,opt=sel.options[sel.selectedIndex],cc=v.indexOf('OT:')===0?'':v,
        city=$('#locCity').value.trim().replace(/\s+/g,' '),rec=cc==='PK'?locCityRec(city):null;
    if(rec&&(locNorm(city)===locNorm(rec[0])||LOC_ALIAS[locNorm(city)]))city=rec[0];
    return{cc:cc,country:opt?opt.text:'',city:city,area:$('#locArea').value.trim().replace(/\s+/g,' '),address:$('#locAddr').value.trim(),state:lm.state||(rec?rec[1]:''),lat:lm.lat,lon:lm.lon,src:lm.src};
  }
  function lmLists(){
    var cc=$('#locCountry').value,rec=cc==='PK'?locCityRec($('#locCity').value):null,areas=rec?LOC_AREAS[rec[0]]||[]:[],st=$('#locState');
    $('#locCityList').innerHTML=cc==='PK'?LOC_CITIES.map(function(c){return'<option value="'+esc(c[0])+'">'}).join(''):'';
    $('#locAreaList').innerHTML=areas.map(function(a){return'<option value="'+esc(a)+'">'}).join('');
    var s=lm.state||(rec?rec[1]:'');st.hidden=!s;st.textContent=s?'Province / region: '+s:'';
  }
  function lmInfo(){
    var d=lmRead(),box=$('#locInfo');
    if(d.city.length<2){box.hidden=true;box.innerHTML='';return}
    var i=locInfo(d);
    if(!i.ok)box.className='lm-info no',box.innerHTML='<span class="ii">'+ic('x')+'</span><div><b>Delivery isn’t available here yet</b><p>'+esc(i.reason)+'</p></div>';
    else{
      box.className='lm-info';
      box.innerHTML='<span class="ii">'+ic('check')+'</span><div><b>Delivery available to '+esc(d.city)+'</b>'+
        '<p>Delivery charge: <b style="display:inline;font-size:inherit">Rs. '+fmt(i.fee)+'</b> <span class="mut">(free on orders above Rs. '+fmt(LOC_FREE)+')</span></p>'+
        '<p>Estimated delivery: <b style="display:inline;font-size:inherit">'+locDates(i.min,i.max)+'</b></p>'+
        (i.known?'':'<p class="mut">Standard rates apply to other cities in Pakistan.</p>')+'</div>';
    }
    box.hidden=false;
  }
  function lmFill(d){
    d=d||{};var cc=locCcOf(d),sel=$('#locCountry');
    if(!cc&&d.country){cc='OT:'+d.country}
    if(!cc)cc='PK';
    var has=false,k;for(k=0;k<sel.options.length;k++){if(sel.options[k].value===cc)has=true}
    if(!has){var o=document.createElement('option');o.value=cc;o.textContent=d.country||cc;sel.appendChild(o)}
    sel.value=cc;
    $('#locCity').value=d.city||'';$('#locArea').value=d.area||'';$('#locAddr').value=d.address||'';
    lm.state=d.state||'';lm.lat=d.lat==null?null:d.lat;lm.lon=d.lon==null?null:d.lon;lm.src=d.src||'manual';
    lmLists();lmInfo();lmErrs();
  }
  function lmList(items,status,kind){
    lm.items=items;lm.act=-1;
    var ul=$('#locList'),q=$('#locQ');
    ul.innerHTML=items.map(function(it,k){return'<li role="option" id="locOpt'+k+'" data-k="'+k+'" aria-selected="false"><span class="lo-i">'+ic('pin')+'</span><span class="lo-t"><b>'+esc(it.title)+'</b><small>'+esc(it.sub)+'</small></span></li>'}).join('');
    ul.hidden=!items.length;q.setAttribute('aria-expanded',items.length?'true':'false');q.removeAttribute('aria-activedescendant');
    var s=$('#locSMsg');s.className='lm-hint'+(kind?' '+kind:'');s.textContent=status||'';
  }
  function lmActive(k){
    var o=$('#locList').children,i;
    for(i=0;i<o.length;i++)o[i].setAttribute('aria-selected',i===k?'true':'false');
    lm.act=k;
    if(k>=0&&o[k]){$('#locQ').setAttribute('aria-activedescendant',o[k].id);o[k].scrollIntoView({block:'nearest'})}else $('#locQ').removeAttribute('aria-activedescendant');
  }
  function lmPick(k){
    var it=lm.items[k];if(!it)return;
    var d={};for(var p in it.d)d[p]=it.d[p];
    d.src='search';if(!d.address)d.address=$('#locAddr').value.trim();
    lmFill(d);lmList([],'');$('#locQ').value='';lmTab('manual');
    lmMsg('ok','Location selected. Add your house or street address, check the details, then save.');
    if(!$('#locAddr').value.trim())$('#locAddr').focus();else $('#locSave').focus();
  }
  function lmSearchRemote(q,my){
    var url='/search?format=jsonv2&addressdetails=1&limit=6&accept-language=en&viewbox=60.87,37.10,77.84,23.69&bounded=0&q='+encodeURIComponent(q);
    locFetch(url,9000).then(function(rows){
      if(my!==lm.seq)return;
      var local=locLocal(q),seen={},out=[];
      local.forEach(function(it){seen[locNorm(it.d.city+' '+it.d.area)]=1;out.push(it)});
      (rows||[]).forEach(function(r){
        var g=locFromNom(r);if(!g.city)return;
        var key=locNorm(g.city+' '+g.area);
        if(seen[key]&&!g.address)return;seen[key]=1;
        var nm=locNorm(g.name),title=(g.name&&nm!==locNorm(g.city)&&nm!==locNorm(g.area))?g.name:(g.address||g.area||g.city),sk={},sub=[];
        [g.area,g.city,g.state,g.country].forEach(function(p){var k=locNorm(p);if(p&&!sk[k]&&k!==locNorm(title)){sk[k]=1;sub.push(p)}});
        out.push({title:title,sub:sub.join(', '),d:g});
      });
      out=out.slice(0,8);
      lmList(out,out.length?'':'No places found. Try different spelling, or switch to “Enter manually”.',out.length?'':'err');
    }).catch(function(e){
      if(my!==lm.seq||(e&&e.name==='AbortError'&&lm.seq!==my))return;
      var local=locLocal(q);
      lmList(local,local.length?'Online search is unavailable right now. Showing built-in results; you can also enter your address manually.':'Online search is unavailable and nothing matched our built-in list. Please switch to “Enter manually”.',local.length?'':'err');
    });
  }
  function lmSearchInput(){
    var q=$('#locQ').value.trim();clearTimeout(lm.timer);lm.seq++;
    if(q.length<2){lmList([],'Type at least 2 letters to search.');return}
    var local=locLocal(q);
    lmList(local,q.length>=3?'Searching…':'');
    if(q.length>=3){var my=lm.seq;lm.timer=setTimeout(function(){lmSearchRemote(q,my)},450)}
    else if(!local.length)lmList([],'Keep typing…');
  }

  /* use my current location (browser Geolocation API, always with the customer's permission) */
  function lmGpsBusy(b){var g=$('#locGps');g.disabled=b;g.classList.toggle('busy',b);$('#locGpsT').textContent=b?'Detecting your location…':'Use my current location'}
  function lmFallback(text){lmGpsBusy(false);lmTab('manual');lmMsg('warn',text);$('#locCity').focus()}
  function lmGps(){
    lmMsg('');
    if(!navigator.geolocation){lmFallback('Your browser can’t detect your location. Search for your area or enter your address below.');return}
    if(window.isSecureContext===false){lmFallback('Location detection only works on secure (https) pages. Search for your area or enter your address below.');return}
    var my=++lm.gseq;lmGpsBusy(true);lmMsg('info','Allow location access when your browser asks. This usually takes a few seconds.');
    navigator.geolocation.getCurrentPosition(function(pos){
      if(my!==lm.gseq||!lm.open)return;
      var lat=+pos.coords.latitude.toFixed(5),lon=+pos.coords.longitude.toFixed(5);
      locFetch('/reverse?format=jsonv2&addressdetails=1&zoom=18&accept-language=en&lat='+lat+'&lon='+lon,8000).then(function(j){
        if(!j||!j.address)throw new Error('none');
        var g=locFromNom(j);g.lat=lat;g.lon=lon;return g;
      }).catch(function(){return locNearest(lat,lon)}).then(function(g){
        if(my!==lm.gseq||!lm.open)return;
        g.src='gps';lmGpsBusy(false);lmFill(g);lmTab('manual');
        if(g.near)lmMsg('warn',g.city?'We couldn’t look up your exact address, so we matched the nearest city ('+g.city+'). Please check it and add your street address.':'We found your position but couldn’t match it to a city. Please enter your city and address.');
        else lmMsg('ok','Location detected. Add your house or street address if it’s missing, check the details, then save.');
        $(g.city?'#locAddr':'#locCity').focus();
      });
    },function(err){
      if(my!==lm.gseq||!lm.open)return;
      var c=err&&err.code;
      lmFallback(c===1?'Location permission was denied. To use detection, allow location access for this site in your browser settings. Or search for your area or enter your address below.':
        c===3?'Detecting your location took too long. Please try again, or search for your area or enter your address below.':
        'We couldn’t work out your location right now. Search for your area or enter your address below.');
    },{enableHighAccuracy:true,timeout:12000,maximumAge:60000});
  }

  function openLoc(notice,kind){
    if(lm.open)return;
    lm.prev=document.activeElement;lm.open=true;
    var u=curUser();
    lmFill(LOC||{country:'Pakistan',cc:'PK'});
    lmTab(LOC?'manual':'search');lmList([],'Type at least 2 letters to search.');$('#locQ').value='';
    lmGpsBusy(false);lmMsg(notice?(kind||'info'):'',notice||'');
    $('#locAcct').hidden=!!u;$('#locClear').hidden=!LOC;
    $('#locScrim').hidden=false;document.body.style.overflow='hidden';
    try{if(!notice&&navigator.permissions&&navigator.permissions.query)navigator.permissions.query({name:'geolocation'}).then(function(p){
      if(p.state==='denied'&&lm.open&&$('#locMsg').hidden)lmMsg('warn','Location access is blocked for this site in your browser, so detection won’t work. Search for your area or enter your address instead.');
    },function(){})}catch(x){}
    $('#locGps').focus();
  }
  function lmClose(quiet){
    if(!lm.open)return;
    lm.open=false;lm.seq++;lm.gseq++;clearTimeout(lm.timer);
    $('#locScrim').hidden=true;document.body.style.overflow='';
    if(!quiet&&lm.prev&&lm.prev.focus&&document.contains(lm.prev))lm.prev.focus();
  }
  function lmSave(){
    if(lm.tab==='search'&&!$('#locCity').value.trim()){
      var s=$('#locSMsg');s.className='lm-hint err';s.textContent='Search for your location and pick it from the list, or switch to “Enter manually”.';$('#locQ').focus();return;
    }
    var d=lmRead(),ec='',ea='';
    if(d.city.length<2)ec='Enter your city.';
    if(d.address.length<5)ea='Enter your complete delivery address (house, street, landmark).';
    if(ec||ea){lmTab('manual');lmErrs(ec,ea);(ec?$('#locCity'):$('#locAddr')).focus();return}
    lmErrs();
    var l={country:d.country,cc:d.cc,state:d.state,city:d.city,area:d.area,address:d.address,lat:d.lat,lon:d.lon,src:d.src,ts:Date.now()};
    var acct=locWrite(l);
    LOC=locRead()||l;locRender();lmClose();locRefresh();
    var i=locInfo(LOC);
    toast(i&&!i.ok?'Saved, but we don’t deliver to '+(LOC.country||'that location')+' yet.':(acct?'Delivery location saved to your account.':'Delivery location saved on this device.'));
  }
  function locClear(){
    locWrite(null);LOC=locRead();locRender();lmClose();locRefresh();toast('Delivery location removed.');
  }

  (function locInit(){
    var sel=$('#locCountry');
    sel.innerHTML=LOC_CTRY.map(function(c){return'<option value="'+c[0]+'">'+esc(c[1])+'</option>'}).join('');
    document.addEventListener('click',function(e){
      var b=e.target.closest('[data-loc-open]');if(!b)return;
      e.preventDefault();openLoc();
    });
    $('#locClose').addEventListener('click',function(){lmClose()});
    $('#locCancel').addEventListener('click',function(){lmClose()});
    $('#locScrim').addEventListener('mousedown',function(e){if(e.target===this)lmClose()});
    $('#locGps').addEventListener('click',lmGps);
    $('#locTabSearch').addEventListener('click',function(){lmTab('search');$('#locQ').focus()});
    $('#locTabManual').addEventListener('click',function(){lmTab('manual')});
    $('#locSave').addEventListener('click',lmSave);
    $('#locForm').addEventListener('submit',function(e){e.preventDefault();lmSave()});
    $('#locClear').addEventListener('click',locClear);
    $('#locLogin').addEventListener('click',function(){lmClose(true);openAuth('login')});
    sel.addEventListener('change',function(){lm.lat=lm.lon=null;lm.state='';lm.src='manual';lmLists();lmInfo()});
    $('#locCity').addEventListener('input',function(){lm.lat=lm.lon=null;lm.state='';lm.src='manual';lmLists();lmInfo();if(this.value.trim().length>1)$('#locCityE').textContent=''});
    $('#locAddr').addEventListener('input',function(){if(this.value.trim().length>4){$('#locAddrE').textContent='';this.setAttribute('aria-invalid','false')}});
    $('#locQ').addEventListener('input',lmSearchInput);
    $('#locQ').addEventListener('keydown',function(e){
      var n=lm.items.length;
      if(e.key==='ArrowDown'&&n){e.preventDefault();lmActive((lm.act+1)%n)}
      else if(e.key==='ArrowUp'&&n){e.preventDefault();lmActive(lm.act<=0?n-1:lm.act-1)}
      else if(e.key==='Enter'){e.preventDefault();if(n)lmPick(lm.act>=0?lm.act:0)}
      else if(e.key==='Escape'&&n){e.stopPropagation();lmList([],'')}
    });
    $('#locList').addEventListener('mousedown',function(e){e.preventDefault()});
    $('#locList').addEventListener('click',function(e){var li=e.target.closest('li[data-k]');if(li)lmPick(+li.dataset.k)});
    $('#locScrim').addEventListener('keydown',function(e){
      if(e.key==='Escape'){e.preventDefault();lmClose();return}
      if(e.key!=='Tab')return;
      var f=[].filter.call(this.querySelectorAll('button,[href],input,select,textarea'),function(x){return !x.disabled&&x.offsetParent!==null&&x.tabIndex>=0});
      if(!f.length)return;
      var a=f[0],z=f[f.length-1];
      if(e.shiftKey&&(document.activeElement===a||document.activeElement===this.firstElementChild)){e.preventDefault();z.focus()}
      else if(!e.shiftKey&&document.activeElement===z){e.preventDefault();a.focus()}
    });
    window.addEventListener('storage',function(e){if(e.key===LOC_GKEY)locSync()});
    locSync();locReady=true;
  })();

  window.addEventListener('hashchange',route);
  captureRef();syncAuthUi();
  route();
  if(refPrompt){
    if(curUser())toast('You are already logged in. Log out first to join through an invitation link.');
    else openAuth('signup');
  }
})();
</script>

</body>
</html>
