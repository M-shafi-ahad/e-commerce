  <symbol id="i-bag" viewBox="0 0 48 48"><rect x="8" y="17" width="32" height="24" rx="4"/><path d="M17 17v-4a7 7 0 0 1 14 0v4M8 27h32"/></symbol>
  <symbol id="i-shirt" viewBox="0 0 48 48"><path d="M17 6L5 13l5 9 5-3v23h18V19l5 3 5-9-12-7a8 8 0 0 1-14 0z"/></symbol>
  <symbol id="i-lamp" viewBox="0 0 48 48"><path d="M15 6h18l6 18H9z"/><path d="M24 24v16M16 42h16"/></symbol>
  <symbol id="i-bottle" viewBox="0 0 48 48"><rect x="16" y="18" width="16" height="25" rx="4"/><rect x="20" y="7" width="8" height="11" rx="2"/><path d="M16 29h16"/></symbol>
  <symbol id="i-laptop" viewBox="0 0 48 48"><rect x="9" y="11" width="30" height="21" rx="3"/><path d="M4 37h40l-3 3H7z"/></symbol>
  <symbol id="i-basket" viewBox="0 0 48 48"><path d="M6 20h36l-4 20H10z"/><path d="M16 20l6-12M32 20l-6-12M18 28v6M24 28v6M30 28v6"/></symbol>
  <symbol id="i-bowl" viewBox="0 0 48 48"><path d="M6 22h36a18 18 0 0 1-36 0z"/><path d="M18 42h12M16 15c0-3 3-3 3-7M24 15c0-3 3-3 3-7M32 15c0-3 3-3 3-7"/></symbol>
  <symbol id="i-sack" viewBox="0 0 48 48"><path d="M17 9h14l-2 6c9 6 12 13 12 20a5 5 0 0 1-5 5H12a5 5 0 0 1-5-5c0-7 3-14 12-20z"/><path d="M17 9l7 4 7-4"/></symbol>
  <symbol id="i-jar" viewBox="0 0 48 48"><rect x="12" y="14" width="24" height="28" rx="5"/><rect x="14" y="7" width="20" height="7" rx="2"/><path d="M12 24h24"/></symbol>
  <symbol id="i-snack" viewBox="0 0 48 48"><path d="M12 6h24l-2 36H14z"/><path d="M12 6l2 5h20l2-5M18 24h12M18 31h12"/></symbol>
  <symbol id="i-cup" viewBox="0 0 48 48"><path d="M8 16h26v12a10 10 0 0 1-10 10h-6A10 10 0 0 1 8 28z"/><path d="M34 19h3a5 5 0 0 1 0 10h-3M16 6v5M24 6v5"/></symbol>
  <symbol id="i-carton" viewBox="0 0 48 48"><path d="M14 18l5-9h10l5 9v24H14z"/><path d="M14 18h20M19 9v9"/></symbol>
  <symbol id="i-fruit" viewBox="0 0 48 48"><circle cx="24" cy="28" r="14"/><path d="M24 14c0-5 3-7 6-8"/></symbol>
  <symbol id="i-keyboard" viewBox="0 0 48 48"><rect x="4" y="14" width="40" height="22" rx="4"/><path d="M10 21h2M17 21h2M24 21h2M31 21h2M10 28h28"/></symbol>
  <symbol id="i-charger" viewBox="0 0 48 48"><rect x="14" y="10" width="20" height="16" rx="3"/><path d="M19 10V4M29 10V4M24 26v6a6 6 0 0 0 6 6h4"/></symbol>
  <symbol id="i-speaker" viewBox="0 0 48 48"><rect x="12" y="5" width="24" height="38" rx="5"/><circle cx="24" cy="17" r="3"/><circle cx="24" cy="31" r="7"/></symbol>
  <symbol id="i-camera" viewBox="0 0 48 48"><rect x="5" y="14" width="38" height="26" rx="4"/><path d="M16 14l3-6h10l3 6"/><circle cx="24" cy="27" r="7"/></symbol>
  <symbol id="i-tablet" viewBox="0 0 48 48"><rect x="9" y="6" width="30" height="36" rx="4"/><path d="M21 37h6"/></symbol>
  <symbol id="i-pants" viewBox="0 0 48 48"><path d="M13 6h22l3 36h-9l-5-22-5 22h-9z"/><path d="M13 12h22"/></symbol>
  <symbol id="i-dress" viewBox="0 0 48 48"><path d="M19 5l5 6 5-6 3 14 8 23H8l8-23z"/></symbol>
  <symbol id="i-trash" viewBox="0 0 24 24"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13M10 11v6M14 11v6"/></symbol>
  <symbol id="i-heart" viewBox="0 0 24 24"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.4A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></symbol>
  <symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></symbol>
  <symbol id="i-users" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><circle cx="17" cy="9" r="2.8"/><path d="M17 14.5a5.5 5.5 0 0 1 4.5 5.5"/></symbol>
  <symbol id="i-link" viewBox="0 0 24 24"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></symbol>
  <symbol id="i-share" viewBox="0 0 24 24"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.7 10.6l6.6-4M8.7 13.4l6.6 4"/></symbol>
  <symbol id="i-back" viewBox="0 0 24 24"><path d="M19 12H5M11 6l-6 6 6 6"/></symbol>
  <symbol id="i-check" viewBox="0 0 24 24"><path d="M5 12l5 5 9-10"/></symbol>
  <symbol id="i-lock" viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></symbol>
  <symbol id="i-truck" viewBox="0 0 24 24"><path d="M2 6h11v10H2zM13 10h5l3 3v3h-8"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></symbol>
  <symbol id="i-cart" viewBox="0 0 24 24"><circle cx="9" cy="20" r="1.6"/><circle cx="18" cy="20" r="1.6"/><path d="M2 3h3l2.6 12.4a1 1 0 0 0 1 .8h9.2a1 1 0 0 0 1-.8L21 7H6"/></symbol>
  <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></symbol>
  <symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></symbol>
  <symbol id="i-fb" viewBox="0 0 24 24"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8z"/></symbol>
  <symbol id="i-ig" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r=".6"/></symbol>
  <symbol id="i-yt" viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="4"/><path d="M10 9.5v5l4.5-2.5z"/></symbol>
  <symbol id="i-tt" viewBox="0 0 24 24"><path d="M14 3v11a4 4 0 1 1-4-4M14 3c.4 2.6 2 4.2 5 4.5"/></symbol>
  <symbol id="i-x" viewBox="0 0 24 24"><path d="M4 4l16 16M20 4L4 20"/></symbol>
  <symbol id="i-eye" viewBox="0 0 24 24"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></symbol>
  <symbol id="i-eyeoff" viewBox="0 0 24 24"><path d="M3 3l18 18M10.6 5.1A10 10 0 0 1 12 5c6.4 0 10 7 10 7a17 17 0 0 1-3.2 4.2M6.6 6.7A17 17 0 0 0 2 12s3.6 7 10 7a9.7 9.7 0 0 0 4.4-1"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/></symbol>
  <symbol id="i-mail" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3 8l9 6 9-6"/></symbol>
  <symbol id="i-pin" viewBox="0 0 24 24"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.6"/></symbol>
  <symbol id="i-gps" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3.2"/><circle cx="12" cy="12" r="7.5"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/></symbol>
  <symbol id="i-lchev" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></symbol>
